+): ActivityMetadataSegment[] {
+	if (!metadata || !preferences || !preferences.enabled || preferences.motion === "plain") return [];
+	const segments: ActivityMetadataSegment[] = [];
+	if (preferences.showOutputTokens && metadata.output > 0)
+		segments.push({ order: 2, text: `${preferences.ascii ? "out " : "↓"}${metadata.output} tokens` });
+	if (preferences.showElapsed)
+		segments.push({ order: 0, text: `${Math.max(0, Math.floor((performance.now() - metadata.startedAt) / 1000))}s` });
+	if (preferences.showAction && genericWorking && metadata.action) segments.push({ order: 1, text: metadata.action });
+	return segments;
+}
+
+export function fitActivityMetadata(
+	base: string,
+	segments: ActivityMetadataSegment[],
+	width: number,
+	ascii: boolean,
+	color: (text: string) => string,
+): string | undefined {
+	while (true) {
+		const suffix = activityMetadataSuffix(segments, ascii);
+		if (visibleWidth(base) + visibleWidth(suffix) <= width) return base + (suffix ? color(suffix) : "");
+		if (!segments.length) return undefined;
+		segments.shift();
+	}
+}
+
+export function activityMetadataSuffix(segments: ActivityMetadataSegment[], ascii: boolean): string {
+	return segments.length
+		? ` (${[...segments]
+				.sort((a, b) => a.order - b.order)
+				.map((segment) => segment.text)
+				.join(ascii ? " | " : " · ")})`
+		: "";
+}
