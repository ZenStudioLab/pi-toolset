+import type { StatusIndicator } from "./components/status-indicator.ts";
+
+/** Presentation ownership only. Native event handlers and status constructors own activity. */
+export class NativeActivityDecoration {
+	private controller: ActivityDecorationController | undefined;
+	private registration: symbol | undefined;
+	private resetting = false;
+	private owner: StatusIndicator | undefined;
+	private ownerGeneration = 0;
+	private revision = 0;
+	private runId: symbol | undefined;
+	private foregroundRun = false;
+	private runStartedAt: number | undefined;
+	private observationEpoch = 0;
+	private tools = new Map<string, string>();
+	private response: { token: symbol; output: number; receiving: boolean } | undefined;
+	private finalizedOutput = 0;
+	private elapsedTimer: ReturnType<typeof setTimeout> | undefined;
+	private elapsedToken = 0;
+	private nativeRunLifetimes = new Map<symbol, symbol>();
+	private hostVisible = true;
+	private waits = new Set<symbol>();
+	private runner: ExtensionRunner | undefined;
+	private unsubscribe: (() => void) | undefined;
+	private runnerWaiting = false;
+	private presentation: ActivityDecorationPresentation = { glyph: "hidden" };
