@@ -0,0 +1,42 @@
+import type { ActivityIndicatorPreferences } from "../activity-indicator-preferences.ts";
+
+/** Native foreground status kinds that support presentation-only decoration. */
+export type ActivityDecorationKind = "working" | "retry" | "compaction" | "branchSummary";
+
+/** Content-free, host-authoritative presentation state. Run identity survives native phase changes. */
+export interface ActivityDecorationSnapshot {
+	readonly runId: symbol | undefined;
+	readonly ownerGeneration: number;
+	readonly kind: ActivityDecorationKind | undefined;
+	/** Producer provenance only: generic Working can present words; actual messages never can. */
+	readonly genericWorking: boolean;
+	readonly eligible: boolean;
+	readonly visible: boolean;
+	readonly waiting: boolean;
+	/** Normalized saved settings plus only explicit invocation overrides. */
+	readonly preferences: Readonly<ActivityIndicatorPreferences>;
+}
+
+/** Only host-marked generic Working may be replaced; actual messages and hints remain native. */
+export interface ActivityDecorationPresentation {
+	/** Complete single-line decorative label, including any desired ellipsis. */
+	label?: string;
+	/** Invalid/unavailable bank provenance: omit label and format generic native Working with punctuation. */
+	nativeTextFallback?: true;
+	/** Reserved terminal cells for the complete label, excluding the separating space. */
+	reservedWidth?: number;
+	glyph: "animated" | "static" | "hidden";
+}
+
+/** Returns false after registration revocation or native owner replacement. */
+export type ActivityDecorationUpdate = (presentation: ActivityDecorationPresentation) => boolean;
+
+export interface ActivityDecorationController {
+	/** Called synchronously, initially and on host transitions. Use state, not callback counts. */
+	onSnapshot(snapshot: ActivityDecorationSnapshot, update: ActivityDecorationUpdate): void;
+	/** Host calls this exactly once when the registration is removed or revoked. */
+	dispose(): void;
+}
+
+/** Invoked only after interactive eligibility and exclusive registration ownership are established. */
+export type ActivityDecorationFactory = () => ActivityDecorationController;
