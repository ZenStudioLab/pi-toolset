+import { visibleWidth } from "@earendil-works/pi-tui";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ACTIVITY_PRESETS } from "../src/modes/interactive/activity-presets.ts";
+import { createWhimsicalSource, type WhimsicalSource } from "./whimsical-source-support.ts";
+
+const fixtures: WhimsicalSource[] = [];
+async function source(options: Parameters<typeof createWhimsicalSource>[0] = {}) {
+	const f = await createWhimsicalSource({
+		...options,
+		harness: {
+			...options.harness,
+			settings: {
+				...options.harness?.settings,
+				activityIndicator: { showElapsed: false, ...options.harness?.settings?.activityIndicator },
+			},
+		},
+	});
+	fixtures.push(f);
+	return f;
+}
+function advance(f: WhimsicalSource, ms: number) {
+	vi.advanceTimersByTime(ms);
+	f.clock.advance(ms);
+}
+afterEach(() => {
+	while (fixtures.length) fixtures.pop()!.cleanup();
+	vi.useRealTimers();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+
+describe("actual InteractiveMode/native presets with current word controller", () => {
+	it.each(ACTIVITY_PRESETS)(
+		"AM05/09/10: $id uses native 80ms frames and stable cells, then freezes its representative without selecting a word",
+		async (preset) => {
+			const f = await source({ harness: { settings: { activityIndicator: { animation: preset.id } } } });
+			vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout", "setInterval", "clearInterval", "performance"] });
+			await f.busy();
