+		if (!preferences.showElapsed || owner.hasActivityAnimation()) {
+			this.cancelElapsedTimer();
+			return;
+		}
+		if (this.elapsedTimer !== undefined) return;
+		const token = ++this.elapsedToken;
+		const run = this.runId;
+		const registration = this.registration;
+		const generation = this.ownerGeneration;
+		this.elapsedTimer = setTimeout(() => {
+			if (
+				token !== this.elapsedToken ||
+				run !== this.runId ||
+				registration !== this.registration ||
+				generation !== this.ownerGeneration ||
+				owner !== this.owner
+			)
+				return;
+			this.elapsedTimer = undefined;
+			this.refreshMetadata();
+		}, 1000);
+	}
+
+	private hasCurrentNativeRun(): boolean {
+		return this.runId !== undefined && [...this.nativeRunLifetimes.values()].includes(this.runId);
+	}
+
+	getPreferenceState(): {
+		available: boolean;
+		saved: Readonly<ActivityIndicatorPreferences>;
+		effective: Readonly<ActivityIndicatorPreferences>;
+		overrides: Readonly<ActivityDecorationOverrides>;
+	} {
+		const saved = this.preferences();
+		return {
+			available: !!this.registration,
+			saved,
+			effective: Object.freeze({ ...saved, ...this.overrides }),
+			overrides: Object.freeze({ ...this.overrides }),
+		};
+	}
+
+	/** Refresh content-free presentation inputs, not run or wait ownership. */
+	refresh(): void {
+		this.publish();
+	}
+
+	private cancelPresetTimer(): void {
+		this.timerToken++;
+		if (this.presetTimer !== undefined) clearTimeout(this.presetTimer);
+		this.presetTimer = undefined;
+	}
+
+	private choosePreset(): void {
+		const candidates = ACTIVITY_PRESETS.filter((preset) => preset.id !== this.presetId);
+		const index = Math.min(candidates.length - 1, Math.max(0, Math.floor(this.random() * candidates.length)));
+		this.presetId = candidates[index]!.id;
+	}
+
+	private applyPresentation(visible: boolean, preferences: Readonly<ActivityIndicatorPreferences>): void {
+		const owner = this.owner;
+		if (!owner) {
+			this.applyMetadata(false, preferences);
+			this.presetDeadline = undefined;
+			this.cancelPresetTimer();
+			return;
+		}
+		if (!preferences.enabled) {
+			this.presetDeadline = undefined;
+			this.cancelPresetTimer();
+			owner.setActivityDecoration(undefined);
+			this.applyMetadata(false, preferences);
+			return;
+		}
+		const shown = visible && this.presentation.glyph !== "hidden" && preferences.motion !== "plain";
+		if (!shown) {
+			this.presetDeadline = undefined;
+			this.cancelPresetTimer();
