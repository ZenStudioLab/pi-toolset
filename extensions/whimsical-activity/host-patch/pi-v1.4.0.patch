+		if (this.presetTimer !== undefined) return;
+		const token = ++this.timerToken;
+		const registration = this.registration;
+		const generation = this.ownerGeneration;
+		const run = this.runId;
+		this.presetTimer = setTimeout(
+			() => {
+				if (
+					token !== this.timerToken ||
+					registration !== this.registration ||
+					generation !== this.ownerGeneration ||
+					run !== this.runId ||
+					this.owner !== owner ||
+					!this.eligible()
+				)
+					return;
+				this.presetTimer = undefined;
+				this.choosePreset();
+				this.presetDeadline = performance.now() + 8000;
+				this.applyPresentation(true, preferences);
+				this.redraw();
+			},
+			Math.max(0, this.presetDeadline - performance.now()),
+		);
+	}
+
+	private publish(): void {
+		const revision = ++this.revision;
+		const registration = this.registration;
+		if (!registration || !this.controller) return;
+		const owner = this.owner;
+		const preferences = this.getPreferenceState().effective;
+		if (this.presetRun !== this.runId) {
+			this.presetRun = this.runId;
+			this.presetId = undefined;
+			this.presetDeadline = undefined;
+			// A previous run's visible presentation must not select/animate before the new controller gate.
+			this.presentation = { glyph: "hidden" };
+		}
