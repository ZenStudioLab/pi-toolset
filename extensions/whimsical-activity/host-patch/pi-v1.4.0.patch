diff --git a/packages/coding-agent/test/native-activity-decoration.test.ts b/packages/coding-agent/test/native-activity-decoration.test.ts
new file mode 100644
index 000000000..efc6fde21
--- /dev/null
+++ b/packages/coding-agent/test/native-activity-decoration.test.ts
@@ -0,0 +1,311 @@
+import { type TUI, visibleWidth } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import type { ActivityDecorationSnapshot, ActivityDecorationUpdate } from "../src/core/extensions/index.ts";
+import { createExtensionRuntime } from "../src/core/extensions/loader.ts";
+import { ExtensionRunner } from "../src/core/extensions/runner.ts";
+import { KeybindingsManager } from "../src/core/keybindings.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { NativeActivityDecoration } from "../src/modes/interactive/activity-decoration.ts";
+import { CustomEditor } from "../src/modes/interactive/components/custom-editor.ts";
+import { RetryStatusIndicator, WorkingStatusIndicator } from "../src/modes/interactive/components/status-indicator.ts";
+import { getEditorTheme, initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+import { createInMemoryModelRegistry } from "./model-runtime-test-utils.ts";
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	const promise = new Promise<T>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+
+function fixture(eligible = true) {
+	const tui = { requestRender: vi.fn(), terminal: { rows: 10 } } as unknown as TUI;
+	const diagnostics: string[] = [];
+	const host = new NativeActivityDecoration(
+		() => eligible,
+		() => tui.requestRender(),
+		(text) => diagnostics.push(text),
+	);
+	const snapshots: ActivityDecorationSnapshot[] = [];
+	const handles: ActivityDecorationUpdate[] = [];
+	const dispose = vi.fn();
+	const remove = host.register(() => ({
+		onSnapshot: (snapshot, update) => {
+			snapshots.push(snapshot);
+			handles.push(update);
+		},
+		dispose,
+	}));
+	const indicator = new WorkingStatusIndicator(tui, "Working", { frames: ["a", "b"], intervalMs: 80 });
+	host.beginRun();
+	host.setOwner(indicator);
+	return { host, tui, snapshots, handles, indicator, dispose, remove, diagnostics };
+}
+
+describe("native activity decoration presentation ownership", () => {
+	beforeEach(() => {
+		initTheme("dark");
+		vi.useFakeTimers();
+	});
+	afterEach(() => vi.useRealTimers());
+
+	it("publishes frozen content-free state; rejects obsolete owners and revoked registrations", () => {
+		const f = fixture();
+		const snapshot = f.snapshots.at(-1)!;
+		expect(Object.isFrozen(snapshot)).toBe(true);
+		expect(Object.keys(snapshot).sort()).toEqual([
+			"eligible",
+			"genericWorking",
+			"kind",
+			"ownerGeneration",
+			"preferences",
+			"runId",
+			"visible",
+			"waiting",
+		]);
+		const old = f.handles.at(-1)!;
+		expect(old({ label: "Pondering…", reservedWidth: 14, glyph: "static" })).toBe(true);
+		const retry = new RetryStatusIndicator(f.tui, 1, 3, 4000);
+		f.host.setOwner(retry);
+		f.indicator.dispose();
+		expect(f.snapshots.at(-1)!.runId).toBe(snapshot.runId);
+		expect(old({ glyph: "animated" })).toBe(false);
+		expect(stripAnsi(retry.render(100)[1]!)).not.toContain("Pondering…");
+		vi.advanceTimersByTime(1000);
+		f.remove!();
+		f.remove!();
+		expect(f.dispose).toHaveBeenCalledTimes(1);
+		expect(f.handles.at(-1)!({ glyph: "hidden" })).toBe(false);
+		expect(stripAnsi(retry.render(100)[1]!)).toContain("in 3s");
+		expect(stripAnsi(retry.render(100)[1]!)).not.toContain("Pondering");
+		retry.dispose();
+	});
+
+	it("retains run identity through agent-end gaps and standalone native retry phases", () => {
+		const f = fixture();
+		const run = f.snapshots.at(-1)!.runId;
+		f.host.setOwner(undefined);
+		f.indicator.dispose();
+		expect(f.snapshots.at(-1)).toMatchObject({ runId: run, visible: false });
+		f.host.settleRun();
+		expect(f.snapshots.at(-1)!.runId).toBeUndefined();
+		const finish = f.host.beginNativeRun();
+		const nativeRun = f.snapshots.at(-1)!.runId;
+		const retry = new RetryStatusIndicator(f.tui, 1, 3, 3000);
+		f.host.setOwner(retry);
+		f.host.setOwner(undefined);
+		expect(f.snapshots.at(-1)!.runId).toBe(nativeRun);
+		finish();
+		finish();
+		expect(f.snapshots.at(-1)!.runId).toBeUndefined();
+		retry.dispose();
+		f.host.reset();
+	});
+
+	it("combines real runner depth with overlapping native waits and silently revokes old runners", async () => {
+		const f = fixture();
+		const registry = await createInMemoryModelRegistry(AuthStorage.inMemory());
+		const runner = new ExtensionRunner(
+			[],
+			createExtensionRuntime(),
+			process.cwd(),
+			SessionManager.inMemory(),
+			registry,
+		);
+		const pending = deferred<boolean>();
+		runner.setUIContext({ ...runner.getUIContext(), confirm: () => pending.promise }, "tui");
+		f.host.bindRunner(runner);
+		const oldUpdate = f.handles.at(-1)!;
+		const result = runner.getUIContext().confirm("private title", "private prompt");
+		expect(f.snapshots.at(-1)).toMatchObject({ waiting: true, visible: false });
+		expect(oldUpdate({ glyph: "animated" })).toBe(false);
+		expect(vi.getTimerCount()).toBe(0);
+		const finishA = f.host.beginWait();
+		const finishB = f.host.beginWait();
+		pending.resolve(true);
+		await result;
+		finishA();
+		finishA();
+		expect(f.snapshots.at(-1)!.waiting).toBe(true);
+		finishB();
+		expect(f.snapshots.at(-1)).toMatchObject({ waiting: false, visible: true });
+		runner.invalidate();
+		f.host.reset();
+		const nextRunner = new ExtensionRunner(
+			[],
+			createExtensionRuntime(),
+			process.cwd(),
+			SessionManager.inMemory(),
+			registry,
+		);
+		f.host.bindRunner(nextRunner);
+		expect(f.dispose).toHaveBeenCalledTimes(1);
+		f.indicator.dispose();
+	});
+
+	it("owns no animation for delay, static, waiting, or host-hidden presentation; restores native controls", () => {
+		const f = fixture();
+		expect(vi.getTimerCount()).toBe(0);
+		expect(stripAnsi(f.indicator.renderInBorder(50))).toBe("Working");
+		f.handles.at(-1)!({ label: "Thinking…", reservedWidth: 14, glyph: "static" });
+		expect(vi.getTimerCount()).toBe(1); // MD07: optional elapsed refresh, not animation.
+		f.handles.at(-1)!({ label: "Thinking…", reservedWidth: 14, glyph: "animated" });
+		expect(vi.getTimerCount()).toBe(1);
+		f.host.setHostVisible(false);
+		expect(vi.getTimerCount()).toBe(0);
+		expect(stripAnsi(f.indicator.renderInBorder(50))).toBe("Working");
+		f.host.setHostVisible(true);
+		f.remove!();
+		expect(vi.getTimerCount()).toBe(1);
+		expect(stripAnsi(f.indicator.renderInBorder(50))).toBe("a Working");
+		f.indicator.dispose();
+	});
+
+	it("declines noninteractive, incompatible, and competing factories without constructing them", () => {
+		const factory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+		const noUI = new NativeActivityDecoration(() => false, vi.fn(), vi.fn());
+		expect(noUI.register(factory)).toBeUndefined();
+		const f = fixture();
+		expect(f.host.register(factory)).toBeUndefined();
+		expect(f.host.register(factory)).toBeUndefined();
+		expect(f.diagnostics).toHaveLength(1);
+		f.remove!();
+		expect(f.host.register(factory, false)).toBeUndefined();
+		expect(factory).not.toHaveBeenCalled();
+		f.indicator.dispose();
+	});
+
+	it("fits a complete fixed-width label only after ANSI/wide native status in both paths", () => {
+		const f = fixture();
+		f.indicator.setMessage("\x1b[31m実行中\x1b[0m (Esc to cancel)");
+		f.handles.at(-1)!({ label: "Pondering…", reservedWidth: 14, glyph: "hidden" });
+		const wide = f.indicator.renderInBorder(80);
+		expect(stripAnsi(wide)).toBe("実行中 (Esc to cancel)");
+		const nativeWidth = visibleWidth("実行中 (Esc to cancel)");
+		expect(stripAnsi(f.indicator.renderInBorder(nativeWidth))).toBe("実行中 (Esc to cancel)");
+		for (const width of [0, 1, 4, 12, 30, 80]) {
+			expect(visibleWidth(f.indicator.renderInBorder(width))).toBeLessThanOrEqual(width);
+			for (const line of f.indicator.render(width)) expect(visibleWidth(line)).toBeLessThanOrEqual(width);
+		}
+		f.indicator.dispose();
+		f.host.reset();
+	});
+
+	it("drops decoration before collapsing truthful status for the editor overflow hint", () => {
+		const f = fixture();
+		f.handles.at(-1)!({ label: "Pondering…", reservedWidth: 14, glyph: "static" });
+		const editor = new CustomEditor(f.tui, getEditorTheme(), KeybindingsManager.create(), {
+			embedWorkingStatus: true,
+		});
+		editor.setWorkingStatusIndicator(f.indicator);
+		// Exercise the real border allocator with the native hidden-line count.
+		const border = (editor as unknown as { renderTopBorder(width: number, hidden: number): string }).renderTopBorder(
+			60,
+			5,
+		);
+		expect(stripAnsi(border)).toContain("a Working");
+		expect(stripAnsi(border)).toContain("↑ 5 more");
+		expect(stripAnsi(border)).not.toContain("Pondering");
+		expect(visibleWidth(border)).toBe(60);
+		f.indicator.dispose();
+		f.host.reset();
+	});
+	it("an obsolete standalone completion does not prolong a newer settled foreground run", () => {
+		const f = fixture();
+		f.host.settleRun();
+		const finish = f.host.beginNativeRun();
+		f.host.beginRun();
+		f.host.setOwner(undefined);
+		f.indicator.dispose();
+		f.host.settleRun();
+		expect(f.snapshots.at(-1)!.runId).toBeUndefined();
+		finish();
+		f.host.reset();
+	});
+
+	it("reset declines reentrant registration and nested reset without constructing surviving work", () => {
+		const host = new NativeActivityDecoration(() => true, vi.fn(), vi.fn());
+		const replacementDispose = vi.fn();
+		const replacementFactory = vi.fn(() => {
+			const timer = setInterval(() => {}, 8000);
+			return {
+				onSnapshot: vi.fn(),
+				dispose: () => {
+					clearInterval(timer);
+					replacementDispose();
+				},
+			};
+		});
+		const attempts: ((() => void) | undefined)[] = [];
+		const dispose = vi.fn(() => {
+			clearInterval(timer);
+			attempts.push(host.register(replacementFactory));
+			host.reset();
+			attempts.push(host.register(replacementFactory));
+		});
+		const timer = setInterval(() => {}, 8000);
+		const remove = host.register(() => ({ onSnapshot: vi.fn(), dispose }))!;
+		expect(vi.getTimerCount()).toBe(1);
+		host.reset();
+		remove();
+		expect(dispose).toHaveBeenCalledTimes(1);
+		expect(attempts).toEqual([undefined, undefined]);
+		expect(replacementFactory).not.toHaveBeenCalled();
+		expect(replacementDispose).not.toHaveBeenCalled();
+		expect(vi.getTimerCount()).toBe(0);
+
+		const freshRemove = host.register(replacementFactory);
+		expect(freshRemove).toBeTypeOf("function");
+		expect(replacementFactory).toHaveBeenCalledTimes(1);
+		expect(vi.getTimerCount()).toBe(1);
+		host.reset();
+		freshRemove!();
+		expect(replacementDispose).toHaveBeenCalledTimes(1);
+		expect(vi.getTimerCount()).toBe(0);
+	});
+
+	it("ordinary removal still allows disposal to register a replacement", () => {
+		const host = new NativeActivityDecoration(() => true, vi.fn(), vi.fn());
+		const replacementDispose = vi.fn();
+		const replacementFactory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: replacementDispose }));
+		let replacementRemove: (() => void) | undefined;
+		const dispose = vi.fn(() => {
+			replacementRemove = host.register(replacementFactory);
+		});
+		const remove = host.register(() => ({ onSnapshot: vi.fn(), dispose }))!;
+		remove();
+		remove();
+		expect(dispose).toHaveBeenCalledTimes(1);
+		expect(replacementFactory).toHaveBeenCalledTimes(1);
+		expect(replacementRemove).toBeTypeOf("function");
+		expect(replacementDispose).not.toHaveBeenCalled();
+		replacementRemove!();
+		expect(replacementDispose).toHaveBeenCalledTimes(1);
+		host.reset();
+	});
+
+	it("failing controller/diagnostic cleanup cannot prevent the native producer from proceeding", () => {
+		const dispose = vi.fn();
+		const host = new NativeActivityDecoration(
+			() => true,
+			vi.fn(),
+			() => {
+				throw new Error("diagnostic");
+			},
+		);
+		expect(
+			host.register(() => ({
+				onSnapshot: () => {
+					throw new Error("controller");
+				},
+				dispose,
+			})),
+		).toBeUndefined();
+		expect(dispose).toHaveBeenCalledTimes(1);
+		expect(() => host.beginWait()()).not.toThrow();
+		host.reset();
+	});
+});
diff --git a/packages/coding-agent/test/native-activity-metadata.test.ts b/packages/coding-agent/test/native-activity-metadata.test.ts
new file mode 100644
index 000000000..04d7b9aa7
--- /dev/null
+++ b/packages/coding-agent/test/native-activity-metadata.test.ts
@@ -0,0 +1,171 @@
+import type { TUI } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { normalizeActivityIndicatorPreferences } from "../src/core/activity-indicator-preferences.ts";
+import { NativeActivityDecoration } from "../src/modes/interactive/activity-decoration.ts";
+import { RetryStatusIndicator, WorkingStatusIndicator } from "../src/modes/interactive/components/status-indicator.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+
+function fixture(motion: "normal" | "reduced" | "plain" = "normal") {
+	let prefs = normalizeActivityIndicatorPreferences({ motion });
+	const redraw = vi.fn();
+	const ui = { requestRender: vi.fn() } as unknown as TUI;
+	const host = new NativeActivityDecoration(() => true, redraw, vi.fn(), { preferences: () => prefs });
+	host.register(() => ({
+		onSnapshot(snapshot, update) {
+			if (snapshot.visible)
+				update({ label: "Noodling…", reservedWidth: 14, glyph: motion === "normal" ? "animated" : "static" });
+		},
+		dispose() {},
+	}));
+	host.beginRun();
+	const owner = new WorkingStatusIndicator(ui, "Working", undefined, undefined, { generic: true });
+	host.setOwner(owner);
+	return {
+		host,
+		owner,
+		ui,
+		redraw,
+		text: () => stripAnsi(owner.renderInBorder(200)),
+		change: (fields: Partial<typeof prefs>) => {
+			prefs = { ...prefs, ...fields };
+			host.refresh();
+		},
+		cleanup: () => {
+			host.reset();
+			owner.dispose();
+		},
+	};
+}
+
+beforeEach(() => {
+	initTheme("dark", false);
+	vi.useFakeTimers({ toFake: ["performance", "setTimeout", "clearTimeout", "setInterval", "clearInterval"] });
+});
+afterEach(() => {
+	vi.useRealTimers();
+	vi.restoreAllMocks();
+});
+
+describe("native foreground metadata observations", () => {
+	it("MD01/07: original monotonic start includes waits/retries/repeated start; standalone lifetimes reset", () => {
+		const f = fixture("reduced");
+		expect(f.text()).toContain("(0s)");
+		vi.advanceTimersByTime(39999);
+		expect(f.text()).toContain("(39s)");
+		const run = f.host.getRunId();
+		f.host.beginRun();
+		expect(f.host.getRunId()).toBe(run);
+		const wait = f.host.beginWait();
+		expect(vi.getTimerCount()).toBe(0);
+		vi.advanceTimersByTime(21001);
+		wait();
+		expect(f.text()).toContain("(61s)");
+		const retry = new RetryStatusIndicator(f.ui, 1, 3, 3000);
+		f.host.setOwner(retry);
+		f.owner.dispose();
+		expect(stripAnsi(retry.renderInBorder(200))).toContain("(61s)");
+		expect(stripAnsi(retry.renderInBorder(200))).toContain("in 3s");
+		f.host.setOwner(undefined);
+		retry.dispose();
+		f.host.settleRun();
+		const end = f.host.beginNativeRun();
+		const native = new WorkingStatusIndicator(f.ui, "Native", undefined);
+		f.host.setOwner(native);
+		vi.advanceTimersByTime(2500);
+		expect(stripAnsi(native.renderInBorder(200))).toContain("(2s)");
+		f.host.setOwner(undefined);
+		native.dispose();
+		end();
+		expect(f.host.getRunId()).toBeUndefined();
+		f.cleanup();
+		expect(vi.getTimerCount()).toBe(0);
+	});
+
+	it("MD02: concurrency, nested/unknown ends and sanitized scalar names; no inferred thinking", () => {
+		const f = fixture();
+		expect(f.text()).not.toContain("Thinking");
+		f.host.startTool("a", "\x1b[31mbash\x1b[0m\n\t\x07");
+		expect(f.text()).toContain("Running bash");
+		f.host.startTool("nested", "ignored", "a");
+		f.host.endTool("foreign");
+		expect(f.text()).not.toContain("ignored");
+		f.host.startTool("b", "MCP wrapper");
+		expect(f.text()).toContain("Running 2 tools");
+		f.host.endTool("a");
+		expect(f.text()).toContain("Running MCP wrapper");
+		f.host.endTool("b");
+		expect(f.text()).not.toContain("Running");
+		const response = f.host.beginResponse(0, true);
+		expect(f.text()).toContain("Receiving response");
+		f.host.updateResponse(response, 0, false, true);
+		expect(f.text()).not.toContain("Receiving");
+		f.owner.setWorkingMessage("Running native operation (escape to cancel)", false);
+		f.host.startTool("c", "bash");
+		expect(f.text()).not.toContain("Running bash");
+		expect(f.text()).toContain("Running native operation (escape to cancel)");
+		f.cleanup();
+	});
+
+	it("MD03/04: replace partials, finalize once, include reported aborted/retry output; omit unavailable zeros", () => {
+		const f = fixture();
+		const first = f.host.beginResponse(0, true);
+		expect(f.text()).not.toContain("tokens");
+		f.host.updateResponse(first, 100, true);
+		expect(f.text()).toContain("↓100 tokens");
+		f.host.updateResponse(first, 150, true);
+		expect(f.text()).toContain("↓150 tokens");
+		f.host.updateResponse(first, 150, false, true);
+		f.host.updateResponse(first, 150, false, true);
+		expect(f.text()).toContain("↓150 tokens");
+		f.host.beginRun();
+		const next = f.host.beginResponse(0, false); // final-only adapter: start may already be complete.
+		expect(f.text()).not.toContain("Receiving");
+		expect(f.text()).toContain("↓150 tokens");
+		f.host.updateResponse(next, 40, false, true);
+		expect(f.text()).toContain("↓190 tokens");
+		f.change({ ascii: true });
+		expect(f.text()).toContain("out 190 tokens");
+		f.host.setOwner(undefined);
+		f.host.settleRun();
+		f.host.beginRun();
+		f.host.setOwner(f.owner);
+		f.host.updateResponse(first, 999, true);
+		expect(f.text()).not.toContain("tokens");
+		f.cleanup();
+	});
+
+	it("MD05/07: live toggles retain run; one Reduced elapsed callback <=1/s, render allocates none, stale callback revoked", () => {
+		const timers = vi.spyOn(globalThis, "setTimeout");
+		const f = fixture("reduced");
+		const run = f.host.getRunId();
+		expect(vi.getTimerCount()).toBe(1);
+		const stale = timers.mock.calls.at(-1)![0] as () => void;
+		f.redraw.mockClear();
+		vi.advanceTimersByTime(999);
+		expect(f.redraw).not.toHaveBeenCalled();
+		vi.advanceTimersByTime(1);
+		expect(f.redraw).toHaveBeenCalledTimes(1);
+		const count = timers.mock.calls.length;
+		for (let i = 0; i < 100; i++) f.text();
+		expect(timers.mock.calls).toHaveLength(count);
+		f.change({ showElapsed: false });
+		expect(vi.getTimerCount()).toBe(0);
+		expect(f.text()).not.toContain("s)");
+		f.change({ showElapsed: true, showAction: false, showOutputTokens: false });
+		expect(f.host.getRunId()).toBe(run);
+		expect(vi.getTimerCount()).toBe(1);
+		f.host.setHostVisible(false);
+		expect(vi.getTimerCount()).toBe(0);
+		f.host.setHostVisible(true);
+		expect(vi.getTimerCount()).toBe(1);
+		f.change({ motion: "plain" });
+		expect(vi.getTimerCount()).toBe(0);
+		expect(f.text()).toBe("Working");
+		f.cleanup();
+		f.redraw.mockClear();
+		stale();
+		expect(f.redraw).not.toHaveBeenCalled();
+		expect(vi.getTimerCount()).toBe(0);
+	});
+});
diff --git a/packages/coding-agent/test/native-activity-preferences.test.ts b/packages/coding-agent/test/native-activity-preferences.test.ts
new file mode 100644
index 000000000..1d1b8f3d9
--- /dev/null
+++ b/packages/coding-agent/test/native-activity-preferences.test.ts
@@ -0,0 +1,279 @@
+import type { TUI } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+	type ActivityIndicatorPreferences,
+	normalizeActivityIndicatorPreferences,
+} from "../src/core/activity-indicator-preferences.ts";
+import type { ActivityDecorationSnapshot, ActivityDecorationUpdate } from "../src/core/extensions/index.ts";
+import { NativeActivityDecoration } from "../src/modes/interactive/activity-decoration.ts";
+import { RetryStatusIndicator, WorkingStatusIndicator } from "../src/modes/interactive/components/status-indicator.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+
+function fixture(initial: Partial<ActivityIndicatorPreferences> = {}) {
+	let preferences = normalizeActivityIndicatorPreferences({ showElapsed: false, ...initial });
+	const ui = { requestRender: vi.fn() } as unknown as TUI;
+	const random = vi.fn(() => 0);
+	const redraw = vi.fn();
+	const dispose = vi.fn();
+	const snapshots: ActivityDecorationSnapshot[] = [];
+	const handles: ActivityDecorationUpdate[] = [];
+	const host = new NativeActivityDecoration(() => true, redraw, vi.fn(), { preferences: () => preferences, random });
+	const remove = host.register(() => ({
+		onSnapshot: (snapshot, update) => {
+			snapshots.push(snapshot);
+			handles.push(update);
+		},
+		dispose,
+	}))!;
+	const indicator = new WorkingStatusIndicator(ui, "Working", undefined, undefined, { generic: true });
+	host.beginRun();
+	host.setOwner(indicator);
+	const display = () => handles.at(-1)!({ label: "Noodling…", reservedWidth: 14, glyph: "animated" });
+	const change = (fields: Partial<ActivityIndicatorPreferences>) => {
+		preferences = { ...preferences, ...fields };
+		host.refresh();
+	};
+	const text = () => stripAnsi(indicator.renderInBorder(80));
+	return { host, indicator, ui, random, redraw, dispose, snapshots, handles, remove, display, change, text };
+}
+
+describe("NativeActivityDecoration effective preferences and random ownership", () => {
+	beforeEach(() => {
+		initTheme("dark", false);
+		vi.useFakeTimers({ toFake: ["setInterval", "clearInterval", "setTimeout", "clearTimeout", "performance"] });
+	});
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+	it("AM07: Random selects at actual display only, once per run, retaining through phase/wait/hidden resume", () => {
+		const f = fixture({ animation: "random" });
+		expect(f.random).not.toHaveBeenCalled();
+		expect(vi.getTimerCount()).toBe(0);
+		f.display();
+		expect(f.random).toHaveBeenCalledTimes(1);
+		expect(f.text()).toBe("✻     Noodling…     ");
+		const run = f.snapshots.at(-1)!.runId;
+		vi.advanceTimersByTime(40000);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		const retry = new RetryStatusIndicator(f.ui, 1, 3, 4000);
+		f.host.setOwner(retry);
+		f.indicator.dispose();
+		expect(f.snapshots.at(-1)!.runId).toBe(run);
+		expect(stripAnsi(retry.renderInBorder(120))).not.toContain("Noodling");
+		const finish = f.host.beginWait();
+		vi.advanceTimersByTime(10000);
+		finish();
+		f.host.setHostVisible(false);
+		f.host.setHostVisible(true);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		f.host.setOwner(undefined);
+		retry.dispose();
+		f.host.settleRun();
+		f.host.beginRun();
+		const next = new WorkingStatusIndicator(f.ui, "Working", undefined, undefined, { generic: true });
+		f.host.setOwner(next);
+		f.display();
+		expect(f.random).toHaveBeenCalledTimes(2);
+		f.host.reset();
+		next.dispose();
+	});
+	it("AM05/08: Random Bounce-to-Asterisk switching keeps label column fixed and cannot repeat", () => {
+		const f = fixture({ animation: "random", randomTiming: "periodically" });
+		f.random.mockReturnValueOnce(0.999).mockReturnValue(0);
+		f.display();
+		expect(f.text().startsWith("[●··]")).toBe(true);
+		const column = f.text().indexOf("Noodling");
+		vi.advanceTimersByTime(8000);
+		expect(f.text().startsWith("✻")).toBe(true);
+		expect(f.text().indexOf("Noodling")).toBe(column);
+		vi.advanceTimersByTime(8000);
+		expect(f.text().startsWith("⠋")).toBe(true);
+		expect(f.text().indexOf("Noodling")).toBe(column);
+		f.host.reset();
+		f.indicator.dispose();
+	});
+
+	it("AM08/10: periodic selects differently every 8s, preserves deadline across phases/color/frames and restarts after wait", () => {
+		const f = fixture({ animation: "random", randomTiming: "periodically" });
+		f.display();
+		vi.advanceTimersByTime(3000);
+		f.change({ color: "claude" });
+		f.display();
+		const retry = new RetryStatusIndicator(f.ui, 1, 3, 9000);
+		f.host.setOwner(retry);
+		f.indicator.dispose();
+		vi.advanceTimersByTime(4999);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		vi.advanceTimersByTime(1);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		expect(stripAnsi(retry.renderInBorder(120)).startsWith("⠋")).toBe(true);
+		const finish = f.host.beginWait();
+		vi.advanceTimersByTime(30000);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		finish();
+		vi.advanceTimersByTime(7999);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		vi.advanceTimersByTime(1);
+		expect(f.random).toHaveBeenCalledTimes(3);
+		f.host.setHostVisible(false);
+		vi.advanceTimersByTime(16000);
+		expect(f.random).toHaveBeenCalledTimes(3);
+		f.host.setHostVisible(true);
+		vi.advanceTimersByTime(8000);
+		expect(f.random).toHaveBeenCalledTimes(4);
+		f.host.reset();
+		retry.dispose();
+		expect(vi.getTimerCount()).toBe(0);
+	});
+	it("AM08: an owner-hidden gap retains the preset but same-run reattachment starts a fresh interval", () => {
+		const f = fixture({ animation: "random", randomTiming: "periodically" });
+		f.display();
+		const run = f.snapshots.at(-1)!.runId;
+		vi.advanceTimersByTime(3000);
+		f.host.setOwner(undefined);
+		f.indicator.dispose();
+		expect(vi.getTimerCount()).toBe(0);
+		vi.advanceTimersByTime(16000);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		const resumed = new WorkingStatusIndicator(f.ui, "Working", undefined, undefined, { generic: true });
+		f.host.setOwner(resumed);
+		f.display();
+		expect(f.snapshots.at(-1)!.runId).toBe(run);
+		expect(stripAnsi(resumed.renderInBorder(80)).startsWith("✻")).toBe(true);
+		vi.advanceTimersByTime(7999);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		vi.advanceTimersByTime(1);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		f.host.reset();
+		resumed.dispose();
+	});
+
+	it("AM08/10: late callback selects at most once and schedules from now; stale phase/run/removal callbacks never select or redraw", () => {
+		const timers = vi.spyOn(globalThis, "setTimeout");
+		const f = fixture({ animation: "random", randomTiming: "periodically" });
+		f.display();
+		const queued = timers.mock.calls.find((call) => call[1] === 8000)![0] as () => void;
+		vi.spyOn(performance, "now").mockReturnValue(40000);
+		queued();
+		expect(f.random).toHaveBeenCalledTimes(2);
+		expect(timers.mock.calls.at(-1)![1]).toBe(8000);
+		const current = timers.mock.calls.at(-1)![0] as () => void;
+		const phase = new WorkingStatusIndicator(f.ui, "Phase", undefined);
+		f.host.setOwner(phase);
+		f.indicator.dispose();
+		const selections = f.random.mock.calls.length;
+		const redraws = f.redraw.mock.calls.length;
+		current();
+		queued();
+		expect(f.random).toHaveBeenCalledTimes(selections);
+		expect(f.redraw).toHaveBeenCalledTimes(redraws);
+		f.host.setOwner(undefined);
+		phase.dispose();
+		f.host.settleRun();
+		f.host.beginRun();
+		f.remove();
+		f.remove();
+		current();
+		expect(f.dispose).toHaveBeenCalledTimes(1);
+		expect(f.random).toHaveBeenCalledTimes(selections);
+		f.host.reset();
+	});
+	it("AM09/10: Reduced freezes preset, Plain/disabled own no switching; explicit animation changes do not recreate controller", () => {
+		const f = fixture({ animation: "random", randomTiming: "periodically" });
+		f.display();
+		const run = f.snapshots.at(-1)!.runId;
+		f.change({ motion: "reduced" });
+		f.display();
+		expect(vi.getTimerCount()).toBe(0);
+		vi.advanceTimersByTime(40000);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		expect(f.text().startsWith("✻")).toBe(true);
+		f.change({ animation: "bounce" });
+		expect(f.text().startsWith("[·●·]")).toBe(true);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		f.change({ motion: "plain" });
+		f.display();
+		expect(f.text()).toBe("Working");
+		expect(vi.getTimerCount()).toBe(0);
+		f.change({ enabled: false });
+		expect(f.snapshots.at(-1)!.visible).toBe(false);
+		expect(f.text()).toBe("⠋ Working"); // Disabled restores unmodified native animation.
+		expect(vi.getTimerCount()).toBe(1);
+		expect(f.dispose).not.toHaveBeenCalled();
+		expect(f.snapshots.at(-1)!.runId).toBe(run);
+		f.change({ enabled: true, motion: "normal", animation: "random" });
+		f.display();
+		expect(f.random).toHaveBeenCalledTimes(2);
+		f.host.reset();
+		f.indicator.dispose();
+	});
+	it("AM10: random timing changes restart only the preset interval and live snapshots stay content-free/frozen", () => {
+		const f = fixture({ animation: "random" });
+		f.display();
+		vi.advanceTimersByTime(4000);
+		f.change({ randomTiming: "periodically" });
+		const state = f.snapshots.at(-1)!;
+		expect(Object.isFrozen(state.preferences)).toBe(true);
+		expect(state.preferences).toMatchObject({ randomTiming: "periodically", text: "whimsical" });
+		vi.advanceTimersByTime(7999);
+		expect(f.random).toHaveBeenCalledTimes(1);
+		vi.advanceTimersByTime(1);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		f.change({ randomTiming: "once-per-run" });
+		vi.advanceTimersByTime(40000);
+		expect(f.random).toHaveBeenCalledTimes(2);
+		f.host.reset();
+		f.indicator.dispose();
+	});
+	it("AM04: optional overrides affect only supplied fields and absent overrides inherit saved values", () => {
+		const saved = normalizeActivityIndicatorPreferences({
+			enabled: false,
+			motion: "reduced",
+			ascii: true,
+			animation: "random",
+		});
+		const host = new NativeActivityDecoration(() => true, vi.fn(), vi.fn(), { preferences: () => saved });
+		const seen: ActivityDecorationSnapshot[] = [];
+		let remove = host.register(() => ({ onSnapshot: (snapshot) => seen.push(snapshot), dispose() {} }))!;
+		expect(seen.at(-1)!.preferences).toEqual(saved);
+		remove();
+		remove = host.register(() => ({ onSnapshot: (snapshot) => seen.push(snapshot), dispose() {} }), true, {
+			motion: "plain",
+		})!;
+		expect(seen.at(-1)!.preferences).toEqual({ ...saved, motion: "plain" });
+		expect(saved.motion).toBe("reduced");
+		remove();
+	});
+	it("AM04/09: hard invocation opt-out is dormant, revocable, and cannot be enabled by saving preferences", () => {
+		let saved = normalizeActivityIndicatorPreferences(undefined);
+		const factory = vi.fn();
+		const redraw = vi.fn();
+		const host = new NativeActivityDecoration(() => true, redraw, vi.fn(), { preferences: () => saved });
+		const ui = { requestRender: vi.fn() } as unknown as TUI;
+		const indicator = new WorkingStatusIndicator(ui, "Working");
+		host.beginRun();
+		host.setOwner(indicator);
+		const native = indicator.renderInBorder(80);
+		const remove = host.register(factory, true, { enabled: false })!;
+		expect(host.getPreferenceState()).toMatchObject({
+			available: true,
+			effective: { enabled: false },
+			overrides: { enabled: false },
+		});
