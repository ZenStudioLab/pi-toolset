+		const token = Symbol();
+		if (!this.foregroundRun) this.setRun(Symbol());
+		const run = this.runId ?? Symbol();
+		this.setRun(run);
+		this.nativeRunLifetimes.set(token, run);
+		this.publish();
+		return () => {
+			if (!this.nativeRunLifetimes.delete(token)) return;
+			if (!this.foregroundRun && !this.hasCurrentNativeRun()) this.setRun(undefined);
+			this.publish();
+		};
+	}
+
+	settleRun(): void {
+		this.foregroundRun = false;
+		this.tools.clear();
+		this.response = undefined;
+		if (!this.hasCurrentNativeRun()) this.setRun(undefined);
+		this.publish();
+	}
+
+	setOwner(owner: StatusIndicator | undefined): void {
+		if (this.owner === owner) return;
+		// Revoke old handles before the caller disposes the old native status.
+		this.ownerGeneration++;
+		this.owner = owner;
+		if (owner && !this.runId) this.setRun(Symbol());
+		else if (!owner && !this.foregroundRun && !this.hasCurrentNativeRun()) this.setRun(undefined);
+		this.publish();
+	}
+
+	setHostVisible(visible: boolean): void {
+		if (this.hostVisible === visible) return;
+		this.hostVisible = visible;
+		this.publish();
+	}
+
+	beginWait(): () => void {
+		const token = Symbol();
+		this.waits.add(token);
+		this.publish();
+		return () => {
+			if (this.waits.delete(token)) this.publish();
+		};
+	}
+
+	checkComposition(supported: boolean): void {
+		if (this.registration && !supported) {
+			this.report("Activity decoration cannot compose with the current editor; leaving that editor intact.");
+			this.remove(this.registration);
+		}
+	}
+
+	reset(): void {
+		if (this.resetting) return;
+		// Controller disposal may reenter registration or reset before teardown finishes.
+		this.resetting = true;
+		try {
+			if (this.registration) this.remove(this.registration);
+			this.unsubscribe?.();
+			this.unsubscribe = undefined;
+			this.runner = undefined;
+			this.runnerWaiting = false;
+			this.waits.clear();
+			this.nativeRunLifetimes.clear();
+			this.foregroundRun = false;
+			this.setRun(undefined);
+			this.observationEpoch++;
+			this.ownerGeneration++;
+			this.revision++;
+		} finally {
+			this.resetting = false;
+		}
+	}
+
+	getObservationEpoch(): number {
+		return this.observationEpoch;
+	}
+
+	private setRun(run: symbol | undefined): void {
+		if (this.runId === run) return;
+		this.runId = run;
+		this.runStartedAt = run ? performance.now() : undefined;
+		this.tools.clear();
+		this.response = undefined;
+		this.finalizedOutput = 0;
+		this.cancelElapsedTimer();
+	}
+
+	/** Public session events are serialized main-agent responses, not stable message objects. */
+	beginResponse(output: number, receiving: boolean): symbol | undefined {
+		if (!this.foregroundRun) return undefined;
+		const token = Symbol();
+		this.response = { token, output: this.reportedOutput(output), receiving };
+		this.refreshMetadata();
+		return token;
+	}
+
+	updateResponse(token: symbol | undefined, output: number, receiving: boolean, final = false): void {
+		if (!token || this.response?.token !== token || !this.foregroundRun) return;
+		this.response.output = this.reportedOutput(output);
+		this.response.receiving = receiving;
+		if (final) {
+			this.finalizedOutput += this.response.output;
+			this.response = undefined;
+		}
+		this.refreshMetadata();
+	}
+
+	startTool(id: string, name: string, parent?: string): void {
+		if (!this.foregroundRun || parent) return;
+		// Strip terminal escapes before controls; never inspect arguments or results.
+		const singleLine = stripAnsi(name)
+			.replace(/[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]/gu, " ")
+			.trim();
+		this.tools.set(id, singleLine);
+		this.refreshMetadata();
+	}
+
+	endTool(id: string): void {
+		if (this.tools.delete(id)) this.refreshMetadata();
+	}
+
+	private reportedOutput(output: number): number {
+		return Number.isSafeInteger(output) && output > 0 ? output : 0;
+	}
+
+	private refreshMetadata(): void {
+		// Observations do not publish selector inputs or revoke word/preset deadlines.
+		if (!this.controller) return;
+		this.applyPresentation(
+			this.eligible() && this.hostVisible && !!this.runId && !this.runnerWaiting && this.waits.size === 0,
+			this.getPreferenceState().effective,
+		);
+		this.redraw();
+	}
+
+	private cancelElapsedTimer(): void {
+		this.elapsedToken++;
+		if (this.elapsedTimer !== undefined) clearTimeout(this.elapsedTimer);
+		this.elapsedTimer = undefined;
+	}
+
+	private applyMetadata(shown: boolean, preferences: Readonly<ActivityIndicatorPreferences>): void {
+		const owner = this.owner;
+		const startedAt = this.runStartedAt;
+		if (!owner || !shown || startedAt === undefined) {
+			owner?.setActivityMetadata(undefined);
+			this.cancelElapsedTimer();
+			return;
+		}
+		const name = this.tools.values().next().value;
+		const action =
+			this.tools.size > 1
+				? `Running ${this.tools.size} tools`
+				: this.tools.size === 1
+					? name
+						? `Running ${name}`
+						: undefined
+					: this.response?.receiving
+						? "Receiving response"
+						: undefined;
+		owner.setActivityMetadata({ startedAt, action, output: this.finalizedOutput + (this.response?.output ?? 0) });
