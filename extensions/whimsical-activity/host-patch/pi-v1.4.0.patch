+	private readonly random: () => number;
+	private overrides: ActivityDecorationOverrides = {};
+	private presetRun: symbol | undefined;
+	private presetId: ActivityPresetId | undefined;
+	private lastPreferences: Readonly<ActivityIndicatorPreferences> | undefined;
