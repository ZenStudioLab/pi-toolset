@@ -0,0 +1,170 @@
+import { fileURLToPath } from "node:url";
+import type { Container, TUI } from "@earendil-works/pi-tui";
+import { vi } from "vitest";
+import whimsicalActivity from "../../../../../extensions/whimsical-activity/index.ts";
+import { ActivityWordSelector } from "../../../../../extensions/whimsical-activity/word-bank.ts";
+import { FakeActivityClock, seededRandom } from "../../../../../test/whimsical-activity/clock.ts";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionEvent } from "../src/core/agent-session.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type {
+	ActivityDecorationSnapshot,
+	ActivityDecorationUpdate,
+	ExtensionUIContext,
+} from "../src/core/extensions/index.ts";
+import type { NativeActivityDecoration } from "../src/modes/interactive/activity-decoration.ts";
+import type { CustomEditor } from "../src/modes/interactive/components/custom-editor.ts";
+import type { SettingsSelectorComponent } from "../src/modes/interactive/components/settings-selector.ts";
+import type { StatusIndicator } from "../src/modes/interactive/components/status-indicator.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+import { createHarness, type HarnessOptions } from "./suite/harness.ts";
+import { createTestExtensionsResult } from "./utilities.ts";
+
+export interface WhimsicalModeAccess {
+	isInitialized: boolean;
+	editor: CustomEditor;
+	ui: TUI;
+	editorContainer: Container;
+	statusContainer: Container;
+	activityDecoration: NativeActivityDecoration;
+	activeStatusIndicator?: StatusIndicator;
+	createExtensionUIContext(): ExtensionUIContext;
+	handleEvent(event: AgentSessionEvent): Promise<void>;
+	subscribeToAgent(): void;
+	resetExtensionUI(): void;
+	showSettingsSelector(): void;
+}
+
+/** Production loader/runner/InteractiveMode/native UI with controlled time, randomness and offline dependencies. */
+export async function createWhimsicalSource(
+	options: {
+		flags?: Record<string, string | boolean>;
+		harness?: HarnessOptions;
+		tty?: [boolean, boolean];
+		bind?: boolean;
+		readAsset?: () => string;
+	} = {},
+) {
+	const input = Object.getOwnPropertyDescriptor(process.stdin, "isTTY");
+	const output = Object.getOwnPropertyDescriptor(process.stdout, "isTTY");
+	Object.defineProperty(process.stdin, "isTTY", { value: options.tty?.[0] ?? true, configurable: true });
+	Object.defineProperty(process.stdout, "isTTY", { value: options.tty?.[1] ?? true, configurable: true });
+	vi.stubEnv("PI_PACKAGE_DIR", fileURLToPath(new URL("../", import.meta.url)));
+	const clock = new FakeActivityClock();
+	const selections: string[] = [];
+	const banks = vi.fn(() => {
+		const selector = new ActivityWordSelector(seededRandom(71), options.readAsset);
+		const next = selector.next.bind(selector);
+		vi.spyOn(selector, "next").mockImplementation(() => {
+			const word = next();
+			selections.push(word);
+			return word;
+		});
+		return selector;
+	});
+	const factories: NonNullable<HarnessOptions["extensionFactories"]> = [
+		...(options.harness?.extensionFactories ?? []),
+		(pi) => {
+			// SAFETY: Published and source API versions differ in unrelated types; the actual loader supplies these identical flag/session ports.
+			whimsicalActivity(pi as unknown as Parameters<typeof whimsicalActivity>[0], banks, clock);
+		},
+	];
+	const harness = await createHarness({ ...options.harness, extensionFactories: factories });
+	// The existing default harness reload is a no-op; recreate inline factories through its real loader for lifecycle tests.
+	const resources = harness.session.resourceLoader;
+	const loaded = resources.getExtensions();
+	vi.spyOn(resources, "reload").mockImplementation(async () => {
+		Object.assign(loaded, await createTestExtensionsResult(factories, harness.tempDir));
+	});
+	vi.stubEnv("PI_CODING_AGENT_DIR", harness.tempDir);
+	initTheme("dark", false);
+	// SAFETY: As in existing native integration tests, constructor consumes only the real session and runtime callback registration ports.
+	const runtime = {
+		session: harness.session,
+		setBeforeSessionInvalidate: vi.fn(),
+		setRebindSession: vi.fn(),
+	} as unknown as AgentSessionRuntime;
+	const terminal = new VirtualTerminal(120, 30);
+	const instance = new InteractiveMode(runtime, { terminal });
+	// SAFETY: These are existing private seams on the actual production instance, not replacement ownership logic.
+	const mode = instance as unknown as WhimsicalModeAccess;
+	mode.isInitialized = true;
+	const ui = mode.createExtensionUIContext();
+	const snapshots: ActivityDecorationSnapshot[] = [];
+	const handles: ActivityDecorationUpdate[] = [];
+	const controllers: ReturnType<Parameters<typeof ui.registerActivityDecoration>[0]>[] = [];
+	const register = ui.registerActivityDecoration.bind(ui);
+	const registration = vi.spyOn(ui, "registerActivityDecoration").mockImplementation((factory, overrides) =>
+		register(() => {
+			const controller = factory();
+			controllers.push(controller);
+			const onSnapshot = controller.onSnapshot.bind(controller);
+			vi.spyOn(controller, "onSnapshot").mockImplementation((snapshot, update) => {
+				snapshots.push(snapshot);
+				handles.push(update);
+				onSnapshot(snapshot, update);
+			});
+			return controller;
+		}, overrides),
+	);
+	for (const [name, value] of Object.entries(options.flags ?? {}))
+		harness.session.extensionRunner.setFlagValue(name, value);
+	const errors: string[] = [];
+	const bind = () =>
+		harness.session.bindExtensions({
+			uiContext: ui,
+			mode: "tui",
+			onError: (error) => {
+				errors.push(error.error);
+			},
+		});
+	if (options.bind !== false) await bind();
+	const event = (value: AgentSessionEvent) => mode.handleEvent(value);
+	const busy = async () => {
+		await event({ type: "agent_start" });
+		await event({ type: "turn_start" });
+	};
+	return {
+		harness,
+		instance,
+		mode,
+		ui,
+		terminal,
+		clock,
+		banks,
+		selections,
+		snapshots,
+		handles,
+		controllers,
+		registration,
+		errors,
+		bind,
+		event,
+		busy,
+		state: () => snapshots.at(-1)!,
+		border: (width = 120) => stripAnsi(mode.activeStatusIndicator?.renderInBorder(width) ?? ""),
+		label: () => selections.at(-1)! + (snapshots.at(-1)?.preferences.ascii ? "..." : "…"),
+		cleanup() {
+			instance.stop();
+			harness.cleanup();
+			if (input) Object.defineProperty(process.stdin, "isTTY", input);
+			else Reflect.deleteProperty(process.stdin, "isTTY");
+			if (output) Object.defineProperty(process.stdout, "isTTY", output);
+			else Reflect.deleteProperty(process.stdout, "isTTY");
+		},
+	};
+}
+
+export type WhimsicalSource = Awaited<ReturnType<typeof createWhimsicalSource>>;
+
+/** Open the actual settings producer and route input through its native nested lists. */
+export function openActivitySettings(f: WhimsicalSource) {
+	f.mode.showSettingsSelector();
+	const selector = f.mode.editorContainer.children[0] as SettingsSelectorComponent;
+	const list = selector.getSettingsList();
+	list.selectItem("activity-indicator");
+	list.handleInput("\r");
+	return { selector, list };
+}
