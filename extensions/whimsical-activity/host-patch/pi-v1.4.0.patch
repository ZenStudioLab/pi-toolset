+import { foregroundAnsi, rgbColor, setCapabilityOverrides, visibleWidth } from "@earendil-works/pi-tui";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ActivityWordSelector } from "../../../../../extensions/whimsical-activity/word-bank.ts";
+import { seededRandom } from "../../../../../test/whimsical-activity/clock.ts";
+import {
+	type ActivityIndicatorPreferences,
+	DEFAULT_ACTIVITY_INDICATOR_PREFERENCES,
+} from "../src/core/activity-indicator-preferences.ts";
+import { initTheme, theme } from "../src/modes/interactive/theme/theme.ts";
+import { stripAnsi } from "../src/utils/ansi.ts";
+import { createWhimsicalSource, openActivitySettings, type WhimsicalSource } from "./whimsical-source-support.ts";
+
+const fixtures: WhimsicalSource[] = [];
+async function source(options: Parameters<typeof createWhimsicalSource>[0] = {}) {
+	const f = await createWhimsicalSource({
+		...options,
+		harness: {
+			...options.harness,
+			settings: {
+				...options.harness?.settings,
+				activityIndicator: { showElapsed: false, ...options.harness?.settings?.activityIndicator },
+			},
+		},
+	});
+	fixtures.push(f);
+	return f;
+}
+function change<K extends keyof ActivityIndicatorPreferences>(
+	f: WhimsicalSource,
+	key: K,
+	value: ActivityIndicatorPreferences[K],
+) {
+	// The actual native picker uses this same SettingsManager write + live refresh port; no fake snapshots/controllers.
+	f.harness.session.settingsManager.setActivityIndicatorPreference(key, value);
+	f.mode.activityDecoration.refresh();
+}
+afterEach(() => {
+	while (fixtures.length) fixtures.pop()!.cleanup();
+	setCapabilityOverrides({});
+	vi.useRealTimers();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+
+describe("current extension with actual native live preferences", () => {
+	it("AM01/02/10: defaults replace generic Working, Operational stops word work, Both restores same word/bag", async () => {
+		const f = await source();
+		vi.useFakeTimers();
+		await f.busy();
+		expect(f.state().preferences).toEqual({ ...DEFAULT_ACTIVITY_INDICATOR_PREFERENCES, showElapsed: false });
+		f.clock.advance(249);
+		expect(f.border()).toBe("Working");
+		f.clock.advance(1);
+		const word = f.label();
+		const run = f.state().runId;
+		const controller = f.controllers[0];
+		const deadline = f.clock.pending()[0];
+		expect(f.border().trimEnd()).toBe(`✻ ${word}`);
+		f.clock.advance(3000);
+		change(f, "animation", "bounce");
+		change(f, "color", "claude");
+		change(f, "ascii", true);
+		expect(f.clock.pending()[0]).toBe(deadline);
+		expect(f.selections).toHaveLength(1);
+		expect(f.border().trimEnd()).toBe(`[●··] ${f.label()}`);
+		change(f, "text", "operational");
+		expect(f.border()).toBe("[●··] Working");
+		expect(f.clock.pending()).toEqual([]);
+		f.clock.deliver(deadline);
+		f.clock.advance(20000);
+		expect(f.selections).toHaveLength(1);
+		change(f, "text", "both");
+		expect(f.border().trimEnd()).toBe(`[●··] Working ${f.label()}`);
+		expect(f.state().runId).toBe(run);
+		expect(f.controllers).toEqual([controller]);
+		expect(f.clock.pending()[0].deadline).toBe(f.clock.time + 8000);
+		f.clock.advance(8000);
+		const reference = new ActivityWordSelector(seededRandom(71));
+		expect(f.selections).toEqual([reference.next(), reference.next()]);
+		expect(f.banks).toHaveBeenCalledTimes(1);
+	});
+
+	it("AM02/09: initially saved Operational uses one visibility gate but never constructs a word bank; explicit text return earns fresh delay", async () => {
+		const f = await source({ harness: { settings: { activityIndicator: { text: "operational" } } } });
+		vi.useFakeTimers();
+		await f.busy();
+		expect(vi.getTimerCount()).toBe(0);
+		f.clock.advance(250);
+		expect(f.border()).toBe("✻ Working");
+		expect(f.clock.pending()).toEqual([]);
+		expect(vi.getTimerCount()).toBe(1); // Native animation only.
+		f.clock.advance(20000);
+		expect(f.banks).not.toHaveBeenCalled();
+		change(f, "text", "whimsical");
+		f.clock.advance(249);
+		expect(f.banks).not.toHaveBeenCalled();
+		f.clock.advance(1);
+		expect(f.border()).toContain(f.label());
+		expect(f.selections).toHaveLength(1);
+	});
+
+	it("AM01/10: first draw waits for producer provenance, while meaningful phases keep earned visibility and existing deadlines", async () => {
+		const f = await source();
+		vi.useFakeTimers();
+		f.ui.setWorkingMessage("Working"); // Explicit spelling must never be mistaken for generic provenance.
+		await f.busy();
+		const run = f.state().runId;
+		f.clock.advance(200);
+		await f.event({ type: "auto_retry_start", attempt: 1, maxAttempts: 3, delayMs: 9000, errorMessage: "offline" });
+		f.clock.advance(50);
+		expect(f.border()).toContain("Retrying (1/3) in 9s... (escape to cancel)");
+		expect(f.banks).not.toHaveBeenCalled();
+		expect(f.clock.pending()).toEqual([]);
+		await f.event({ type: "summarization_retry_attempt_start", source: "branchSummary" });
+		expect(f.border()).toContain("Summarizing branch... (escape to cancel)");
+		await f.event({ type: "turn_start" });
+		expect(f.state()).toMatchObject({ runId: run, genericWorking: false });
+		expect(f.banks).not.toHaveBeenCalled();
+		f.ui.setWorkingMessage();
+		expect(f.selections).toHaveLength(1); // Already-earned delay: no new 250 ms purely for phase/message change.
+		const word = f.label();
+		const deadline = f.clock.pending()[0];
+		f.ui.setWorkingMessage("\x1b[31m実行中\x1b[0m (escape to cancel)");
+		expect(f.border()).toBe("✻ 実行中 (escape to cancel)");
+		expect(f.border()).not.toContain(word);
+		expect(f.clock.pending()[0]).toBe(deadline);
+		f.ui.setWorkingMessage();
+		expect(f.border()).toContain(word);
+		expect(f.clock.pending()[0]).toBe(deadline);
+		expect(Object.keys(f.state()).sort()).toEqual([
+			"eligible",
+			"genericWorking",
+			"kind",
+			"ownerGeneration",
+			"preferences",
+			"runId",
+			"visible",
+			"waiting",
+		]);
+		expect(Object.isFrozen(f.state())).toBe(true);
+		expect(Object.isFrozen(f.state().preferences)).toBe(true);
+	});
+
+	it("AM09/10: live Reduced/Plain/disabled stop feature resources and restore the current word/run without controller recreation", async () => {
+		const f = await source();
+		vi.useFakeTimers();
+		await f.busy();
+		f.clock.advance(250);
+		const word = f.label();
+		const run = f.state().runId;
+		const stale = f.clock.pending()[0];
+		const controller = f.controllers[0];
+		change(f, "motion", "reduced");
+		expect(vi.getTimerCount()).toBe(0);
+		expect(f.clock.pending()).toEqual([]);
+		f.clock.deliver(stale);
+		f.clock.advance(30000);
+		expect(f.border()).toContain(word);
+		change(f, "animation", "bounce");
+		expect(f.border().trimEnd()).toBe(`[·●·] ${word}`);
+		change(f, "motion", "plain");
+		expect(f.border()).toBe("Working");
+		expect(vi.getTimerCount()).toBe(0);
+		change(f, "enabled", false);
+		expect(f.border()).toContain("Working");
+		expect(f.clock.pending()).toEqual([]);
+		expect(vi.getTimerCount()).toBe(1); // The ordinary restored native Loader, not a feature resource.
+		change(f, "enabled", true);
+		expect(f.border()).toBe("Working");
+		change(f, "motion", "normal");
+		expect(f.border().trimEnd()).toBe(`[●··] ${word}`);
+		expect(f.clock.pending()[0].deadline).toBe(f.clock.time + 8000);
+		expect(f.state().runId).toBe(run);
+		expect(f.controllers).toEqual([controller]);
+		expect(f.banks).toHaveBeenCalledTimes(1);
+		expect(f.selections).toHaveLength(1);
+	});
+
+	it.each([false, true])(
+		"AM01/04: actual invalid bank uses typed native fallback with ascii=%s, important messages/hints unchanged and no word rotation",
+		async (ascii) => {
+			const f = await source({
+				readAsset: () => "invalid JSON",
+				harness: { settings: { activityIndicator: { ascii } } },
+			});
+			vi.useFakeTimers();
+			const warning = vi.spyOn(f.mode as unknown as { showWarning(message: string): void }, "showWarning");
+			await f.busy();
+			f.mode.activeStatusIndicator!.setWorkingMessage("Working", true, "(escape to interrupt)");
+			f.mode.activityDecoration.refresh();
+			f.clock.advance(249);
+			expect(f.border()).toBe("Working (escape to interrupt)");
+			f.clock.advance(1);
+			expect(f.border()).toBe(`✻ Working${ascii ? "..." : "…"} (escape to interrupt)`);
+			expect(f.clock.pending()).toEqual([]);
+			expect(f.selections).toEqual([]);
+			expect(warning).toHaveBeenCalledTimes(1);
+			change(f, "text", "both");
+			expect(f.border()).toBe(`✻ Working${ascii ? "..." : "…"} (escape to interrupt)`);
+			f.ui.setWorkingMessage("Working");
+			expect(f.border()).toBe("✻ Working (escape to interrupt)");
+			f.ui.setWorkingMessage("実行中...");
+			expect(f.border()).toBe("✻ 実行中... (escape to interrupt)");
+			f.ui.setWorkingMessage();
+			change(f, "text", "operational");
+			expect(f.border()).toBe("✻ Working (escape to interrupt)");
+			change(f, "motion", "plain");
+			expect(f.border()).toBe("Working (escape to interrupt)");
+			await f.event({ type: "agent_end", messages: [], willRetry: false });
+			await f.event({ type: "agent_settled", aborted: false });
+			await f.busy();
+			change(f, "motion", "normal");
+			change(f, "text", "whimsical");
+			f.clock.advance(250);
+			expect(warning).toHaveBeenCalledTimes(1);
+			expect(f.banks).toHaveBeenCalledTimes(1);
+			expect(f.clock.pending()).toEqual([]);
+		},
+	);
+
+	it.each([true, false])(
+		"AM11: actual current controller renders Claude through trueColor=%s while theme/semantic colors and narrow status priorities remain native",
+		async (trueColor) => {
+			const f = await source();
+			setCapabilityOverrides({ trueColor });
+			initTheme("dark", false);
+			vi.useFakeTimers();
+			await f.busy();
+			f.clock.advance(250);
+			const indicator = f.mode.activeStatusIndicator!;
+			const word = f.label();
+			const deadline = f.clock.pending()[0];
+			const dark = indicator.renderInBorder(120);
+			initTheme("light", false);
+			expect(indicator.renderInBorder(120)).not.toBe(dark);
+			change(f, "color", "claude");
