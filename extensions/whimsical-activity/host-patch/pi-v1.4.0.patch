+		const before = settings.getGlobalSettings();
+		const fields: [number, keyof ActivityIndicatorPreferences, (string | boolean)[]][] = [
+			[0, "enabled", [true, false]],
+			[1, "text", ["whimsical", "operational", "both"]],
+			[3, "randomTiming", ["once-per-run", "periodically"]],
