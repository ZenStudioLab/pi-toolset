@@ -0,0 +1,302 @@
+import type { Component } from "@earendil-works/pi-tui";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ExtensionInputComponent } from "../src/modes/interactive/components/extension-input.ts";
+import { createWhimsicalSource, type WhimsicalSource } from "./whimsical-source-support.ts";
+
+const fixtures: WhimsicalSource[] = [];
+async function source(options: Parameters<typeof createWhimsicalSource>[0] = {}) {
+	const fixture = await createWhimsicalSource(options);
+	fixtures.push(fixture);
+	return fixture;
+}
+afterEach(() => {
+	while (fixtures.length) fixtures.pop()!.cleanup();
+	vi.useRealTimers();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+
+describe("whimsical production entry with native lifecycle", () => {
+	it("AT08–AT12/AT16: real native events retain foreground identity, operational priority and independent deadlines", async () => {
+		const f = await source();
+		vi.useFakeTimers();
+		await f.busy();
+		f.clock.advance(200);
+		await f.event({ type: "agent_end", messages: [], willRetry: false });
+		await f.event({ type: "agent_settled", aborted: false });
+		f.clock.advance(10000);
+		expect(f.banks).not.toHaveBeenCalled();
+		await f.busy();
+		f.clock.advance(249);
+		expect(f.border()).toBe("Working");
+		f.clock.advance(1);
+		expect(f.border()).toContain(f.label());
+		expect(f.selections).toHaveLength(1);
+		const first = f.label();
+		const run = f.state().runId;
+		const deadline = f.clock.pending()[0];
+		const oldStatus = f.mode.activeStatusIndicator!;
+		const oldHandle = f.handles.at(-1)!;
+		const disposed = vi.spyOn(oldStatus, "dispose");
+		// Actual native animation ticks do not advance the independent label clock.
+		vi.advanceTimersByTime(640);
+		expect(f.border()).toContain(first);
+		expect(f.selections).toHaveLength(1);
+		await f.event({
+			type: "tool_execution_end",
+			toolCallId: "background",
+			toolName: "fixture",
+			result: { content: [], details: {} },
+			isError: true,
+		});
+		expect(f.mode.activeStatusIndicator).toBe(oldStatus);
+		f.clock.advance(4000);
+		await f.event({
+			type: "auto_retry_start",
+			attempt: 1,
+			maxAttempts: 3,
+			delayMs: 3000,
+			errorMessage: "offline retry",
+		});
+		expect(f.state().runId).toBe(run);
+		expect(disposed).toHaveBeenCalledTimes(1);
+		expect(oldHandle({ label: "obsolete", glyph: "animated" })).toBe(false);
+		expect(f.clock.pending()[0]).toBe(deadline);
+		expect(f.border()).toContain("Retrying (1/3) in 3s... (escape to cancel)");
+		expect(f.border()).not.toContain(first);
+		vi.advanceTimersByTime(1000);
+		expect(f.border()).toContain("in 2s...");
+		await f.event({ type: "summarization_retry_attempt_start", source: "branchSummary" });
+		expect(f.border()).toContain("Summarizing branch... (escape to cancel)");
+		expect(f.clock.pending()[0]).toBe(deadline);
+		await f.event({ type: "compaction_start", reason: "overflow" });
+		expect(f.border()).toContain("Context overflow detected, Auto-compacting... (escape to cancel)");
+		expect(f.border()).not.toContain(first);
+		expect(f.state().runId).toBe(run);
+		expect(f.clock.pending()[0]).toBe(deadline);
+		expect(f.border()).not.toMatch(/Elapsed|Took|ETA|%/); // No new elapsed source exists on these native statuses.
+		f.clock.advance(3999);
+		expect(f.selections).toHaveLength(1);
+		f.clock.advance(1);
+		expect(f.selections).toHaveLength(2);
+		expect(f.border()).not.toContain(f.label());
+		await f.event({
+			type: "compaction_end",
+			reason: "overflow",
+			result: undefined,
+			aborted: false,
+			willRetry: false,
+		});
+		await f.event({ type: "agent_end", messages: [], willRetry: false });
+		await f.event({ type: "agent_settled", aborted: false });
+		expect(f.clock.pending()).toEqual([]);
+		expect(f.state().runId).toBeUndefined();
+	});
+
+	it("AT13/AT15: real runner permission/input and hidden noncapturing custom operations overlap; legacy order is irrelevant", async () => {
+		let releaseLegacy!: () => void;
+		const legacyGate = new Promise<void>((resolve) => {
+			releaseLegacy = resolve;
+		});
+		const legacy: string[] = [];
+		const f = await source({
+			harness: {
+				extensionFactories: [
+					(pi) => {
