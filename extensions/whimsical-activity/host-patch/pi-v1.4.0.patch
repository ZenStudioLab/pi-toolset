diff --git a/packages/coding-agent/test/whimsical-source-effects.test.ts b/packages/coding-agent/test/whimsical-source-effects.test.ts
new file mode 100644
index 000000000..93899b35c
--- /dev/null
+++ b/packages/coding-agent/test/whimsical-source-effects.test.ts
@@ -0,0 +1,245 @@
+import { createHash } from "node:crypto";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai";
+import { Type } from "typebox";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createWhimsicalSource, openActivitySettings, type WhimsicalSource } from "./whimsical-source-support.ts";
+
+const fixtures: WhimsicalSource[] = [];
+async function source(options: Parameters<typeof createWhimsicalSource>[0] = {}) {
+	const f = await createWhimsicalSource(options);
+	fixtures.push(f);
+	f.mode.subscribeToAgent(); // The production subscription handles actual AgentSession/faux-provider producers.
+	return f;
+}
+afterEach(() => {
+	while (fixtures.length) fixtures.pop()!.cleanup();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+
+describe("whimsical effects at actual host provider and execution boundaries", () => {
+	it("AT23: display/rotation/render/removal call no provider or fetch; actual normalized provider prompt is unchanged", async () => {
+		const f = await source({
+			flags: { "no-whimsical-activity": true },
+			harness: {
+				initialActiveToolNames: [],
+				settings: { retry: { enabled: false }, compaction: { enabled: false } },
+			},
+		});
+		const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(() => {
+			throw new Error("Unexpected network in offline qualification");
+		});
+		const agent = f.harness.session.agent;
+		const original = agent.streamFunction.bind(agent);
+		const prompts: string[] = [];
+		const provider = vi.spyOn(agent, "streamFunction").mockImplementation((model, context, options) => {
+			// Preserve all provider-bound message fields, including prompt sections/tools; only wall-clock timestamps differ.
+			prompts.push(
+				JSON.stringify(context.messages, (key, value: unknown) => (key === "timestamp" ? undefined : value)),
+			);
+			return original(model, context, options);
+		});
+		const runner = f.harness.session.extensionRunner;
+		for (const hook of [
+			"context",
+			"context_with_system",
+			"before_agent_start",
+			"before_provider_request",
+			"after_provider_response",
+		] as const)
+			expect(runner.hasHandlers(hook)).toBe(false);
+		// Both requests use the same explicit system instruction and a fresh in-memory conversation.
+		f.harness.sessionManager.appendMessage({
+			role: "system",
+			content: "Offline qualification instruction: preserve the user's prompt.",
+			timestamp: 1,
+		});
+		agent.state.messages = f.harness.sessionManager.buildSessionContext().messages;
+		f.harness.setResponses([fauxAssistantMessage("offline answer")]);
+		await f.harness.session.prompt("Identical offline prompt.");
+		expect(provider).toHaveBeenCalledTimes(1); // Legitimate baseline host request through the faux provider.
+		f.harness.sessionManager.newSession();
+		agent.reset();
+		f.harness.sessionManager.appendMessage({
+			role: "system",
+			content: "Offline qualification instruction: preserve the user's prompt.",
+			timestamp: 1,
+		});
+		agent.state.messages = f.harness.sessionManager.buildSessionContext().messages;
+		runner.setFlagValue("no-whimsical-activity", false);
+		await runner.emit({ type: "session_start", reason: "new" });
+		let release!: () => void;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		f.harness.setResponses([
+			async () => {
+				await gate;
+				return fauxAssistantMessage("offline answer");
+			},
+		]);
+		const operation = f.harness.session.prompt("Identical offline prompt.");
+		await vi.waitFor(() => expect(provider).toHaveBeenCalledTimes(2));
+		await vi.waitFor(() => expect(f.mode.activeStatusIndicator?.kind).toBe("working"));
+		f.clock.advance(250);
+		expect(f.border()).toContain(f.label());
+		const word = f.label();
+		const run = f.state().runId;
+		const controller = f.controllers[0];
+		const { list } = openActivitySettings(f);
+		expect(f.state()).toMatchObject({ runId: run, waiting: true });
+		list.handleInput("\x1b[B");
+		list.handleInput("\x1b[B");
+		list.handleInput("\r");
+		for (let index = 0; index < 9; index++) list.handleInput("\x1b[B");
+		f.mode.editorContainer.render(80); // Actual preview rendering is inside the monitored interval.
+		list.handleInput("\x1b"); // Cancel first preview without saving.
+		expect(f.harness.session.settingsManager.getActivityIndicatorPreferences().animation).toBe("asterisk");
+		list.handleInput("\r");
+		for (let index = 0; index < 9; index++) list.handleInput("\x1b[B");
+		list.handleInput("\r"); // Confirm Bounce.
+		list.handleInput("\x1b[B");
+		list.handleInput("\x1b[B");
+		list.handleInput("\r"); // Open Color choices.
+		list.handleInput("\x1b[B");
+		list.handleInput("\r"); // Confirm Claude color.
+		list.handleInput("\x1b[B");
+		list.handleInput("\r"); // Open Motion choices.
+		list.handleInput("\x1b[B");
+		list.handleInput("\r"); // Confirm Reduced motion.
+		await f.harness.session.settingsManager.flush();
+		expect(f.state().preferences).toMatchObject({ animation: "bounce", color: "claude", motion: "reduced" });
+		list.handleInput("\x1b");
+		list.handleInput("\x1b");
+		expect(f.state()).toMatchObject({ runId: run, waiting: false });
+		expect(f.controllers).toEqual([controller]);
+		expect(f.border()).toContain(`[·●·] ${word}`);
+		expect(f.selections).toHaveLength(1);
+		f.harness.session.settingsManager.setActivityIndicatorPreference("motion", "normal");
+		f.mode.activityDecoration.refresh();
+		f.clock.advance(8000);
+		expect(f.selections).toHaveLength(2);
+		f.mode.activeStatusIndicator!.render(80);
+		f.mode.editor.render(80);
+		await runner.emit({ type: "session_shutdown", reason: "quit" });
+		expect(provider).toHaveBeenCalledTimes(2); // No third call from indicator display, rotation, rendering or removal.
+		expect(fetch).not.toHaveBeenCalled();
+		expect(prompts[1]).toBe(prompts[0]);
+		release();
+		await operation;
+		expect(f.clock.pending()).toEqual([]);
+		console.log(
+			JSON.stringify({
+				legitimateFauxRequests: provider.mock.calls.length,
+				indicatorProviderRequests: 0,
+				fetchCalls: fetch.mock.calls.length,
+				monitoredOperations: [
+					"native preview/cancel/confirm",
+					"saved animation/color/motion",
+					"live resume/rotate/render/dispose",
+				],
+				identicalModelPromptSHA256: createHash("sha256").update(prompts[0]!).digest("hex"),
+			}),
+		);
+	});
+
+	it("AT16: actual parallel tool completion/error does not acquire or end the unfinished parent status", async () => {
+		let release!: () => void;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const f = await source({
+			harness: {
+				initialActiveToolNames: [],
+				extensionFactories: [
+					(pi) => {
+						pi.registerTool({
+							name: "fast",
+							label: "fast",
+							description: "Offline child failure",
+							parameters: Type.Object({}),
+							execute: async () => {
+								throw new Error("offline child failed");
+							},
+						});
+						pi.registerTool({
+							name: "slow",
+							label: "slow",
+							description: "Offline held child",
+							parameters: Type.Object({}),
+							execute: async () => {
+								await gate;
+								return { content: [{ type: "text", text: "done" }], details: {} };
+							},
+						});
+					},
+				],
+			},
+		});
+		f.harness.session.agent.toolExecution = "parallel";
+		f.harness.setResponses([
+			fauxAssistantMessage([fauxToolCall("fast", {}), fauxToolCall("slow", {})], { stopReason: "toolUse" }),
+			fauxAssistantMessage("parent done"),
+		]);
+		const operation = f.harness.session.prompt("Run the offline children.");
+		await vi.waitFor(() =>
+			expect(
+				f.harness.eventsOfType("tool_execution_end").some((event) => event.toolName === "fast" && event.isError),
+			).toBe(true),
+		);
+		expect(f.harness.eventsOfType("tool_execution_start").some((event) => event.toolName === "slow")).toBe(true);
+		expect(f.harness.session.isStreaming).toBe(true);
+		const owner = f.mode.activeStatusIndicator;
+		const run = f.state().runId;
+		f.clock.advance(250);
+		expect(f.border()).toContain(f.label());
+		expect(f.mode.activeStatusIndicator).toBe(owner);
+		expect(f.state().runId).toBe(run);
+		expect(f.border()).toContain("Running slow");
+		expect(f.harness.eventsOfType("agent_settled")).toHaveLength(0);
+		release();
+		await operation;
+		expect(f.harness.eventsOfType("agent_settled")).toHaveLength(1);
+		expect(f.mode.activeStatusIndicator).toBeUndefined();
+		expect(f.clock.pending()).toEqual([]);
+	});
+
+	it.each(["error", "cancel"] as const)(
+		"AT14–AT15: real %s producer settles parent and queued indicator work cannot reappear",
+		async (outcome) => {
+			let release!: () => void;
+			const gate = new Promise<void>((resolve) => {
+				release = resolve;
+			});
+			const f = await source({
+				harness: {
+					initialActiveToolNames: [],
+					settings: { retry: { enabled: false }, compaction: { enabled: false } },
+				},
+			});
+			f.harness.setResponses([
+				async () => {
+					await gate;
+					return outcome === "error"
+						? fauxAssistantMessage("", { stopReason: "error", errorMessage: "Offline terminal failure" })
+						: fauxAssistantMessage("offline response");
+				},
+			]);
+			const operation = f.harness.session.prompt("Offline terminal outcome.");
+			await vi.waitFor(() => expect(f.mode.activeStatusIndicator?.kind).toBe("working"));
+			f.clock.advance(250);
+			const queued = f.clock.pending()[0];
+			const handle = f.handles.at(-1)!;
+			const cancellation = outcome === "cancel" ? f.harness.session.abort() : Promise.resolve();
+			release();
+			await Promise.all([operation, cancellation]);
+			expect(f.harness.eventsOfType("agent_settled")).toHaveLength(1);
+			expect(f.mode.activeStatusIndicator).toBeUndefined();
+			expect(f.state().runId).toBeUndefined();
+			expect(f.clock.pending()).toEqual([]);
+			f.clock.deliver(queued);
+			expect(handle({ label: "obsolete", glyph: "animated" })).toBe(false);
+			expect(f.selections).toHaveLength(1);
+		},
+	);
+});
