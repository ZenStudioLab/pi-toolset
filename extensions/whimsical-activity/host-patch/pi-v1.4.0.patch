+import assert from "node:assert";
+import { describe, it, type TestContext } from "node:test";
+import { Loader, type LoaderIndicatorOptions } from "../src/components/loader.ts";
+import type { TUI } from "../src/tui.ts";
+
+function setup(t: TestContext, indicator?: LoaderIndicatorOptions) {
+	t.mock.timers.enable({ apis: ["setInterval", "Date"], now: 1_700_000_000_000 });
+	const schedule = t.mock.method(globalThis, "setInterval");
+	let now = 1200;
+	t.mock.method(performance, "now", () => now);
+	const requestRender = t.mock.fn(() => {});
+	const spinnerColor = t.mock.fn((frame: string) => `spin:${frame}`);
+	const messageColor = t.mock.fn((message: string) => `msg:${message}`);
+	// Loader uses only requestRender; no terminal, render loop, or unrelated UI timers are needed.
+	const loader = new Loader({ requestRender } as unknown as TUI, spinnerColor, messageColor, "Working", indicator);
+	t.after(() => loader.stop());
+	return {
+		loader,
+		schedule,
+		requestRender,
+		spinnerColor,
+		messageColor,
+		advanceClock: (ms: number) => {
+			now += ms;
+		},
+	};
+}
+
+function displayed(loader: Loader): string {
+	return loader.render(80)[1].trim();
+}
+
+describe("Loader elapsed-clock timing", () => {
+	it("uses the default 80 ms cadence and selects a delayed frame without replay", (t) => {
+		const { loader, requestRender, schedule, advanceClock } = setup(t);
+		assert.strictEqual(displayed(loader), "spin:⠋ msg:Working");
+		assert.strictEqual(schedule.mock.calls.length, 1);
+		assert.strictEqual(schedule.mock.calls[0].arguments[1], 80);
+		advanceClock(79);
+		t.mock.timers.tick(79);
+		assert.strictEqual(requestRender.mock.calls.length, 1);
+		advanceClock(1);
+		t.mock.timers.tick(1);
+		assert.strictEqual(displayed(loader), "spin:⠙ msg:Working");
+
+		// Only one interval is delivered after suspension; the monotonic clock passed nine frames.
+		advanceClock(648);
+		t.mock.timers.tick(80);
+		assert.strictEqual(displayed(loader), "spin:⠏ msg:Working");
+		assert.strictEqual(requestRender.mock.calls.length, 3);
+		t.mock.timers.tick(1);
+		assert.strictEqual(requestRender.mock.calls.length, 3);
+
+		advanceClock(72);
+		t.mock.timers.tick(79);
+		assert.strictEqual(displayed(loader), "spin:⠋ msg:Working");
+		assert.strictEqual(requestRender.mock.calls.length, 4);
+	});
+
+	it("uses custom cadence and elapsed frame boundaries rather than callback counts", (t) => {
+		const frames = ["a", "b", "c", "d"];
+		const { loader, schedule, requestRender, spinnerColor, advanceClock } = setup(t, { frames, intervalMs: 50 });
+		frames[1] = "changed outside Loader";
+		assert.strictEqual(displayed(loader), "a msg:Working");
+		assert.strictEqual(spinnerColor.mock.calls.length, 0);
+		assert.strictEqual(schedule.mock.calls[0].arguments[1], 50);
+		advanceClock(349);
+		t.mock.timers.tick(50);
+		assert.strictEqual(displayed(loader), "c msg:Working");
+		assert.strictEqual(requestRender.mock.calls.length, 2);
+		advanceClock(1);
+		t.mock.timers.tick(50);
+		assert.strictEqual(displayed(loader), "d msg:Working");
+		advanceClock(100);
+		t.mock.timers.tick(50);
+		assert.strictEqual(displayed(loader), "b msg:Working");
+		// Another callback at the same elapsed time must not advance the frame.
+		t.mock.timers.tick(50);
+		assert.strictEqual(displayed(loader), "b msg:Working");
+	});
+
+	for (const stopped of [false, true]) {
+		it(`start restarts cadence from the displayed frame, ${stopped ? "after stop" : "while running"}`, (t) => {
+			const { loader, schedule, requestRender, advanceClock } = setup(t, {
+				frames: ["a", "b", "c", "d"],
+				intervalMs: 40,
+			});
+			advanceClock(80);
+			t.mock.timers.tick(80);
+			assert.strictEqual(displayed(loader), "c msg:Working");
+			if (stopped) {
+				loader.stop();
+				loader.stop();
+				const renders = requestRender.mock.calls.length;
+				advanceClock(1000);
+				t.mock.timers.tick(1000);
+				assert.strictEqual(displayed(loader), "c msg:Working");
+				assert.strictEqual(requestRender.mock.calls.length, renders);
+			} else {
+				advanceClock(25);
+				t.mock.timers.tick(25);
+			}
+			loader.start();
+			assert.strictEqual(displayed(loader), "c msg:Working");
+			assert.strictEqual(schedule.mock.calls.length, 2);
+			const renders = requestRender.mock.calls.length;
+			advanceClock(39);
+			t.mock.timers.tick(39);
+			assert.strictEqual(requestRender.mock.calls.length, renders);
+			advanceClock(1);
+			t.mock.timers.tick(1);
+			assert.strictEqual(displayed(loader), "d msg:Working");
+			assert.strictEqual(requestRender.mock.calls.length, renders + 1);
+			advanceClock(160);
+			t.mock.timers.tick(40);
+			assert.strictEqual(displayed(loader), "d msg:Working");
+		});
+	}
+
+	it("setIndicator replaces frames and resets both frame and cadence, including while stopped", (t) => {
+		const { loader, schedule, advanceClock } = setup(t, { frames: ["a", "b", "c"], intervalMs: 40 });
+		advanceClock(80);
+		t.mock.timers.tick(80);
+		assert.strictEqual(displayed(loader), "c msg:Working");
+		loader.setIndicator({ frames: ["x", "y", "z", "w"], intervalMs: 50 });
+		assert.strictEqual(displayed(loader), "x msg:Working");
+		assert.strictEqual(schedule.mock.calls.length, 2);
+		assert.strictEqual(schedule.mock.calls[1].arguments[1], 50);
+		advanceClock(49);
+		t.mock.timers.tick(49);
+		assert.strictEqual(displayed(loader), "x msg:Working");
+		advanceClock(1);
+		t.mock.timers.tick(1);
+		assert.strictEqual(displayed(loader), "y msg:Working");
+		advanceClock(250);
+		t.mock.timers.tick(50);
+		assert.strictEqual(displayed(loader), "z msg:Working");
+		loader.stop();
+		advanceClock(1000);
+		t.mock.timers.tick(1000);
+		loader.setIndicator();
+		assert.strictEqual(displayed(loader), "spin:⠋ msg:Working");
+		assert.strictEqual(schedule.mock.calls.length, 3);
+		assert.strictEqual(schedule.mock.calls[2].arguments[1], 80);
+		advanceClock(80);
+		t.mock.timers.tick(80);
+		assert.strictEqual(displayed(loader), "spin:⠙ msg:Working");
+	});
+
+	for (const frames of [[], ["●"], [""]]) {
+		it(`allocates no animation timer for ${JSON.stringify(frames)} frames`, (t) => {
+			const { loader, schedule, requestRender, advanceClock } = setup(t, { frames });
+			const expected = frames[0] ? `${frames[0]} msg:Working` : "msg:Working";
+			assert.strictEqual(displayed(loader), expected);
+			loader.start();
+			loader.start();
+			loader.stop();
+			loader.stop();
+			const renders = requestRender.mock.calls.length;
+			advanceClock(10000);
+			t.mock.timers.tick(10000);
+			assert.strictEqual(displayed(loader), expected);
+			assert.strictEqual(schedule.mock.calls.length, 0);
+			assert.strictEqual(requestRender.mock.calls.length, renders);
+		});
+	}
+
+	it("cleans up live animation when switched to static or hidden frames", (t) => {
+		const { loader, schedule, requestRender, advanceClock } = setup(t, { frames: ["a", "b"], intervalMs: 40 });
+		advanceClock(40);
+		t.mock.timers.tick(40);
+		assert.strictEqual(displayed(loader), "b msg:Working");
+		for (const frames of [["●"], []]) {
+			loader.setIndicator({ frames });
+			loader.start();
+			const renders = requestRender.mock.calls.length;
+			advanceClock(1000);
+			t.mock.timers.tick(1000);
+			assert.strictEqual(displayed(loader), frames[0] ? "● msg:Working" : "msg:Working");
+			assert.strictEqual(requestRender.mock.calls.length, renders);
+			assert.strictEqual(schedule.mock.calls.length, 1);
+		}
+		loader.setIndicator({ frames: ["x", "y"], intervalMs: 60 });
+		assert.strictEqual(displayed(loader), "x msg:Working");
+		advanceClock(60);
+		t.mock.timers.tick(60);
+		assert.strictEqual(displayed(loader), "y msg:Working");
+		assert.strictEqual(schedule.mock.calls.length, 2);
+	});
+
+	it("stopped/replaced preview animation rejects even an already-queued stale callback", (t) => {
+		const { loader, schedule, requestRender, advanceClock } = setup(t, { frames: ["a", "b"], intervalMs: 80 });
+		const stale = schedule.mock.calls[0].arguments[0];
+		loader.stop();
+		const renders = requestRender.mock.calls.length;
+		advanceClock(8000);
+		if (typeof stale !== "function") throw new Error("Expected native animation callback");
+		stale();
+		assert.strictEqual(requestRender.mock.calls.length, renders);
+		loader.setIndicator({ frames: ["x", "y"] });
+		const replacedRenders = requestRender.mock.calls.length;
+		stale();
+		assert.strictEqual(requestRender.mock.calls.length, replacedRenders);
+		assert.strictEqual(displayed(loader), "x msg:Working");
+	});
+
+	it("message, invalidation, and render preserve frame selection without restarting animation", (t) => {
+		const { loader, schedule, requestRender, spinnerColor, messageColor, advanceClock } = setup(t);
+		advanceClock(80);
+		t.mock.timers.tick(80);
+		assert.strictEqual(displayed(loader), "spin:⠙ msg:Working");
+		advanceClock(240);
