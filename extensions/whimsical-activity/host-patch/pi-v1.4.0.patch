--- /dev/null
+++ b/packages/coding-agent/src/modes/interactive/activity-presets.ts
@@ -0,0 +1,56 @@
+import { rgbColor, visibleWidth } from "@earendil-works/pi-tui";
+import type { ActivityIndicatorPreferences, ActivityPresetId } from "../../core/activity-indicator-preferences.ts";
+import { theme } from "./theme/theme.ts";
+
+export interface ActivityPreset {
+	readonly id: ActivityPresetId;
+	readonly name: string;
+	readonly frames: readonly string[];
+	readonly representative: string;
+	readonly width: number;
+}
+
+const sequences: readonly [ActivityPresetId, string, readonly string[], string][] = [
+	["asterisk", "Asterisk", ["✻", "✽", "✶", "✳", "✢", "✳", "✶", "✽"], "✻"],
+	["braille", "Braille", ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"], "⠋"],
+	["dots", "Dots", [".", "..", "...", ".."], "..."],
+	["orbit", "Orbit", ["◴", "◷", "◶", "◵"], "◴"],
+	["arc", "Arc", ["◜", "◝", "◞", "◟"], "◜"],
+	["diamond", "Diamond", ["◇", "◈", "◆", "◈"], "◆"],
+	["pulse", "Pulse", ["·", "•", "●", "•"], "●"],
+	["blocks", "Blocks", ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█", "▇", "▆", "▅", "▄", "▃", "▂"], "▄"],
+	["classic", "Classic", ["|", "/", "-", "\\"], "*"],
+	["bounce", "Bounce", ["[●··]", "[·●·]", "[··●]", "[·●·]"], "[·●·]"],
+];
+
+/** The native renderer and picker share these local sequences, not a second spinner. */
+export const ACTIVITY_PRESETS: readonly ActivityPreset[] = Object.freeze(
+	sequences.map(([id, name, frames, representative]) =>
+		Object.freeze({
+			id,
+			name,
+			frames: Object.freeze(frames),
+			representative,
+			width: Math.max(visibleWidth(representative), ...frames.map(visibleWidth)),
+		}),
+	),
+);
+export const RANDOM_ACTIVITY_WIDTH = Math.max(...ACTIVITY_PRESETS.map((preset) => preset.width));
+export const ACTIVITY_FRAME_INTERVAL_MS = 80;
+
+export function getActivityPreset(id: ActivityPresetId): ActivityPreset {
+	return ACTIVITY_PRESETS.find((preset) => preset.id === id)!;
+}
+
+export function activityPresetFrames(preset: ActivityPreset, width: number, staticGlyph: boolean): string[] {
+	return (staticGlyph ? [preset.representative] : preset.frames).map(
+		(frame) => frame + " ".repeat(width - visibleWidth(frame)),
+	);
+}
+
+// Observed Claude Code 2.1.287 swatch, not a universal Claude theme/animation claim.
+const CLAUDE_ACTIVITY_COLOR = rgbColor(215, 119, 87);
+export function colorActivity(text: string, color: ActivityIndicatorPreferences["color"]): string {
+	if (!text) return text;
+	return color === "claude" ? theme.style(text, { fg: CLAUDE_ACTIVITY_COLOR }) : theme.fg("accent", text);
+}
