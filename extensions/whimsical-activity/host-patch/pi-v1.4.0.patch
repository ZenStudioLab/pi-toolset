+		try {
+			this.controller.onSnapshot(snapshot, (presentation) => {
+				if (this.registration !== registration || this.revision !== revision || this.owner !== owner || !visible) {
+					return false;
+				}
+				this.presentation = { ...presentation };
+				this.applyPresentation(visible, preferences);
+				this.redraw();
+				return true;
+			});
+		} catch (error) {
+			this.remove(registration);
+			this.report(`Activity decoration failed: ${error instanceof Error ? error.message : String(error)}`);
+		}
+		this.redraw();
+	}
+
+	private report(message: string): void {
+		if (this.reported.has(message)) return;
+		this.reported.add(message);
+		try {
+			this.diagnose(message);
+		} catch {
+			// A failed diagnostic must not prevent native input or teardown.
+		}
+	}
+}
