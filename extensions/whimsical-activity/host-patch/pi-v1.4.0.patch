+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type { ActivityDecorationFactory } from "../src/core/extensions/index.ts";
+import * as output from "../src/core/output-guard.ts";
+import { runRpcMode } from "../src/modes/rpc/rpc-mode.ts";
+import { createWhimsicalSource, type WhimsicalSource } from "./whimsical-source-support.ts";
+
+vi.mock("../src/core/output-guard.ts", () => ({
+	takeOverStdout: vi.fn(),
+	writeRawStdout: vi.fn(),
+	flushRawStdout: vi.fn(),
+	waitForRawStdoutBackpressure: vi.fn(),
+}));
+const fixtures: WhimsicalSource[] = [];
+async function source(options: Parameters<typeof createWhimsicalSource>[0] = {}) {
+	const f = await createWhimsicalSource({
+		...options,
+		harness: {
+			...options.harness,
+			settings: {
+				...options.harness?.settings,
+				activityIndicator: { animation: "random", randomTiming: "periodically", color: "claude", ascii: true },
+			},
+		},
+	});
+	fixtures.push(f);
+	return f;
+}
+afterEach(() => {
+	while (fixtures.length) fixtures.pop()!.cleanup();
+	vi.useRealTimers();
+	vi.restoreAllMocks();
+	vi.unstubAllEnvs();
+});
+
+describe("whimsical output eligibility on source contexts", () => {
+	it.each(["print", "json"] as const)(
+		"AT21: actual %s runner context neither allocates feature resources nor registers a factory",
+		async (mode) => {
+			const f = await source({ bind: false });
+			vi.useFakeTimers();
+			const ui = f.harness.session.extensionRunner.getUIContext();
+			const notify = vi.spyOn(ui, "notify");
+			const factory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+			expect(ui.registerActivityDecoration(factory)).toBeUndefined();
+			await f.harness.session.bindExtensions({ mode });
+			expect(factory).not.toHaveBeenCalled();
+			expect(f.registration).not.toHaveBeenCalled();
+			expect(f.controllers).toHaveLength(0);
+			expect(f.banks).not.toHaveBeenCalled();
+			expect(f.clock.pending()).toEqual([]);
+			expect(vi.getTimerCount()).toBe(0);
+			expect(notify).not.toHaveBeenCalled();
+		},
+	);
+
+	it("AT21: actual RPC binding loads the production entry and its no-op native API without protocol writes", async () => {
+		const f = await source({ bind: false });
+		vi.useFakeTimers();
+		const original = f.harness.session.bindExtensions.bind(f.harness.session);
+		const stop = new Error("offline RPC binding observed");
+		const factory = vi.fn<ActivityDecorationFactory>(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+		vi.spyOn(f.harness.session, "bindExtensions").mockImplementation(async (bindings) => {
+			await original(bindings); // Actual runner executes the actual entry's session_start in RPC mode.
+			expect(bindings.uiContext!.registerActivityDecoration(factory)).toBeUndefined();
+			throw stop; // Before attaching process input; no live CLI or infinite loop.
+		});
+		// SAFETY: Existing RPC test boundary consumes the real session and only rebind registration on this runtime port.
+		const runtime = { session: f.harness.session, setRebindSession: vi.fn() } as unknown as AgentSessionRuntime;
+		await expect(runRpcMode(runtime)).rejects.toBe(stop);
+		expect(factory).not.toHaveBeenCalled();
+		expect(f.banks).not.toHaveBeenCalled();
+		expect(f.controllers).toHaveLength(0);
+		expect(f.clock.pending()).toEqual([]);
+		expect(vi.getTimerCount()).toBe(0);
+		expect(output.writeRawStdout).not.toHaveBeenCalled();
+	});
+
+	it.each([
+		[false, true],
+		[true, false],
+		[false, false],
+	] as [boolean, boolean][])(
+		"AT21: source TUI entry with input TTY=%s/output TTY=%s is a no-op",
+		async (input, redirected) => {
+			const f = await source({ tty: [input, redirected] });
+			vi.useFakeTimers();
+			expect(f.registration).not.toHaveBeenCalled();
+			expect(f.controllers).toHaveLength(0);
+			expect(f.banks).not.toHaveBeenCalled();
+			expect(f.clock.pending()).toEqual([]);
+			const factory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+			expect(f.ui.registerActivityDecoration(factory)).toBeUndefined();
+			expect(factory).not.toHaveBeenCalled();
+			expect(vi.getTimerCount()).toBe(0);
+			expect(output.writeRawStdout).not.toHaveBeenCalled();
+		},
+	);
+
+	it("AT22: disabled and invalid preferences leave real native status and editor intact", async () => {
+		const f = await source({ flags: { "no-whimsical-activity": true } });
+		const editor = f.mode.editor;
+		await f.busy();
+		const owner = f.mode.activeStatusIndicator;
+		const native = f.border();
+		const warning = vi.spyOn(f.mode as unknown as { showWarning(message: string): void }, "showWarning");
+		const runner = f.harness.session.extensionRunner;
+		runner.setFlagValue("no-whimsical-activity", false);
+		runner.setFlagValue("activity-display", "invalid");
+		await f.bind();
+		await f.bind();
+		expect(warning).toHaveBeenCalledTimes(1);
+		expect(f.controllers).toHaveLength(0);
+		expect(f.banks).not.toHaveBeenCalled();
+		expect(f.clock.pending()).toEqual([]);
+		expect(f.mode.activeStatusIndicator).toBe(owner);
+		expect(f.mode.editor).toBe(editor);
+		expect(f.border()).toBe(native);
+	});
+});
