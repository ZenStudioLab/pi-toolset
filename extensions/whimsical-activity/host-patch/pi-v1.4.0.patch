+		const eligible = this.eligible();
+		const visible = eligible && this.hostVisible && !!owner && !!this.runId && !waiting && preferences.enabled;
+		const snapshot: ActivityDecorationSnapshot = Object.freeze({
+			runId: this.runId,
+			ownerGeneration: this.ownerGeneration,
+			kind: owner?.kind,
+			genericWorking: owner?.genericWorking ?? false,
+			eligible,
+			visible,
+			waiting,
+			preferences,
+		});
