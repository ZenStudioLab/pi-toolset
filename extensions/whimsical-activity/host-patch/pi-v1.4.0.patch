@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { AgentSession } from "../src/core/agent-session.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { createExtensionRuntime } from "../src/core/extensions/loader.ts";
+import { ExtensionRunner } from "../src/core/extensions/runner.ts";
+import type { ExtensionUIContext } from "../src/core/extensions/types.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { runRpcMode } from "../src/modes/rpc/rpc-mode.ts";
+import { createInMemoryModelRegistry } from "./model-runtime-test-utils.ts";
+
+vi.mock("../src/core/output-guard.ts", () => ({
+	takeOverStdout: vi.fn(),
+	writeRawStdout: vi.fn(),
+	flushRawStdout: vi.fn(),
+	waitForRawStdoutBackpressure: vi.fn(),
+}));
+
+describe("activity decoration headless API consumers", () => {
+	afterEach(() => vi.useRealTimers());
+
+	it.each(["print", "json"] as const)("%s no-op registration never constructs a controller", async (mode) => {
+		const registry = await createInMemoryModelRegistry(AuthStorage.inMemory());
+		const runner = new ExtensionRunner(
+			[],
+			createExtensionRuntime(),
+			process.cwd(),
+			SessionManager.inMemory(),
+			registry,
+		);
+		runner.setUIContext(undefined, mode);
+		vi.useFakeTimers();
+		const factory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+		expect(
+			runner.getUIContext().registerActivityDecoration(factory, { motion: "reduced", ascii: true }),
+		).toBeUndefined();
+		expect(factory).not.toHaveBeenCalled();
+		expect(vi.getTimerCount()).toBe(0);
+	});
+
+	it("RPC's production UI context ignores the factory without protocol output or timers", async () => {
+		let ui: ExtensionUIContext | undefined;
+		const stop = new Error("captured production RPC context");
+		// SAFETY: Stop during the existing binding boundary, before RPC attaches process input handlers.
+		const runtime = {
+			session: {
+				bindExtensions: async (bindings: Parameters<AgentSession["bindExtensions"]>[0]) => {
+					ui = bindings.uiContext;
+					throw stop;
+				},
+			},
+			setRebindSession: vi.fn(),
+		} as unknown as AgentSessionRuntime;
+		vi.useFakeTimers();
+		await expect(runRpcMode(runtime)).rejects.toBe(stop);
+		const factory = vi.fn(() => ({ onSnapshot: vi.fn(), dispose: vi.fn() }));
+		expect(ui!.registerActivityDecoration(factory, { enabled: false, motion: "plain" })).toBeUndefined();
+		expect(factory).not.toHaveBeenCalled();
+		expect(vi.getTimerCount()).toBe(0);
+	});
+});
diff --git a/packages/coding-agent/test/activity-indicator-preferences.test.ts b/packages/coding-agent/test/activity-indicator-preferences.test.ts
new file mode 100644
index 000000000..79a02a1d7
--- /dev/null
+++ b/packages/coding-agent/test/activity-indicator-preferences.test.ts
@@ -0,0 +1,165 @@
+import { describe, expect, it } from "vitest";
+import {
+	type ActivityIndicatorPreferences,
+	DEFAULT_ACTIVITY_INDICATOR_PREFERENCES,
+	normalizeActivityIndicatorPreferences,
+} from "../src/core/activity-indicator-preferences.ts";
+import { InMemorySettingsStorage, SettingsManager } from "../src/core/settings-manager.ts";
+
+function contents(storage: InMemorySettingsStorage, scope: "global" | "project") {
+	let result: string | undefined;
+	storage.withLock(scope, (current) => {
+		result = current;
+		return undefined;
+	});
+	return result;
+}
+
+describe("activityIndicator native settings", () => {
+	it.each([undefined, null, [], "bad", 3])("AM04: defaults malformed object %s in memory only", (value) => {
+		expect(normalizeActivityIndicatorPreferences(value)).toEqual(DEFAULT_ACTIVITY_INDICATOR_PREFERENCES);
+	});
+	it("AM03/04: validates siblings independently, preserves layering and writes only confirmed nested global fields", async () => {
+		const storage = new InMemorySettingsStorage();
+		const global = JSON.stringify({
+			theme: "light",
+			activityIndicator: {
+				motion: "reduced",
+				color: "invalid",
+				ascii: true,
+				showElapsed: false,
+				showAction: "invalid",
+				foreign: { retained: 7 },
+			},
+			terminal: { showImages: false },
+		});
+		const project = JSON.stringify({ activityIndicator: { animation: "random", motion: "plain" } });
+		storage.withLock("global", () => global);
+		storage.withLock("project", () => project);
+		const settings = SettingsManager.fromStorage(storage);
+		expect(settings.getActivityIndicatorPreferences()).toEqual({
+			...DEFAULT_ACTIVITY_INDICATOR_PREFERENCES,
+			animation: "random",
+			motion: "plain",
+			ascii: true,
+			showElapsed: false,
+		});
+		expect(Object.isFrozen(settings.getActivityIndicatorPreferences())).toBe(true);
+		await settings.flush();
+		expect(contents(storage, "global")).toBe(global);
+		expect(contents(storage, "project")).toBe(project);
+		settings.setActivityIndicatorPreference("color", "claude");
+		settings.setActivityIndicatorPreference("motion", "normal");
+		await settings.flush();
+		expect(JSON.parse(contents(storage, "global")!)).toEqual({
+			theme: "light",
+			activityIndicator: {
+				motion: "normal",
+				color: "claude",
+				ascii: true,
+				showElapsed: false,
+				showAction: "invalid",
+				foreign: { retained: 7 },
+			},
+			terminal: { showImages: false },
+		});
+		expect(contents(storage, "project")).toBe(project);
+		const next = SettingsManager.fromStorage(storage);
+		expect(next.getActivityIndicatorPreferences()).toMatchObject({
+			motion: "plain",
+			animation: "random",
+			color: "claude",
+			ascii: true,
+		});
+		const persisted = contents(storage, "global");
+		next.applyOverrides({ activityIndicator: { text: "operational" } });
+		expect(next.getActivityIndicatorPreferences()).toMatchObject({
+			text: "operational",
+			color: "claude",
+			motion: "plain",
+		});
+		expect(contents(storage, "global")).toBe(persisted);
+	});
+	it.each([
+		["enabled", false],
+		["text", "both"],
+		["animation", "random"],
+		["randomTiming", "periodically"],
+		["color", "claude"],
+		["motion", "reduced"],
+		["ascii", true],
+		["showElapsed", false],
+		["showAction", false],
+		["showOutputTokens", false],
+	] satisfies [
+		keyof ActivityIndicatorPreferences,
+		ActivityIndicatorPreferences[keyof ActivityIndicatorPreferences],
+	][])("AM03: confirmed %s persists and reloads through storage", async (key, value) => {
+		const storage = new InMemorySettingsStorage();
+		const settings = SettingsManager.fromStorage(storage);
+		settings.setActivityIndicatorPreference(key, value);
+		await settings.flush();
+		const next = SettingsManager.fromStorage(storage);
+		expect(next.getActivityIndicatorPreferences()[key]).toBe(value);
+		expect(next.getGlobalSettings()).toEqual({ activityIndicator: { [key]: value } });
+	});
+
+	it("AM04: each invalid field falls back without discarding valid booleans or valid siblings", () => {
+		expect(
+			normalizeActivityIndicatorPreferences({
+				enabled: false,
+				text: "bad",
+				animation: "dots",
+				randomTiming: 2,
+				color: "claude",
+				motion: "bad",
+				ascii: true,
+			}),
+		).toEqual({
+			...DEFAULT_ACTIVITY_INDICATOR_PREFERENCES,
+			enabled: false,
+			animation: "dots",
+			color: "claude",
+			ascii: true,
+		});
+	});
+	it("MD05: metadata booleans merge per field across global/project/override without writing on read", async () => {
+		const storage = new InMemorySettingsStorage();
+		const global = JSON.stringify({
+			activityIndicator: { showElapsed: false, showAction: false, showOutputTokens: true },
+			theme: "dark",
+		});
+		const project = JSON.stringify({ activityIndicator: { showElapsed: true, showOutputTokens: false } });
+		storage.withLock("global", () => global);
+		storage.withLock("project", () => project);
+		const settings = SettingsManager.fromStorage(storage);
+		expect(settings.getActivityIndicatorPreferences()).toMatchObject({
+			showElapsed: true,
+			showAction: false,
+			showOutputTokens: false,
+		});
+		settings.applyOverrides({ activityIndicator: { showAction: true } });
+		expect(settings.getActivityIndicatorPreferences()).toMatchObject({
+			showElapsed: true,
+			showAction: true,
+			showOutputTokens: false,
+		});
+		await settings.flush();
+		expect(contents(storage, "global")).toBe(global);
+		expect(contents(storage, "project")).toBe(project);
+	});
+	it.each([null, "bad", []])(
+		"AM03: a confirmed field repairs malformed activity object %s without saving defaults",
+		async (activityIndicator) => {
