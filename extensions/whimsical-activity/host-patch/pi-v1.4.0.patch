diff --git a/packages/coding-agent/test/interactive-mode-dialog-status.test.ts b/packages/coding-agent/test/interactive-mode-dialog-status.test.ts
new file mode 100644
index 000000000..fcf322e19
--- /dev/null
+++ b/packages/coding-agent/test/interactive-mode-dialog-status.test.ts
@@ -0,0 +1,95 @@
+import type { Container, ProgramStatus, Terminal } from "@earendil-works/pi-tui";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { VirtualTerminal } from "../../tui/test/virtual-terminal.ts";
+import type { AgentSessionRuntime } from "../src/core/agent-session-runtime.ts";
+import type { ExtensionUIContext } from "../src/core/extensions/index.ts";
+import { InteractiveMode } from "../src/modes/interactive/interactive-mode.ts";
+import { initTheme } from "../src/modes/interactive/theme/theme.ts";
+import { createHarness, type Harness } from "./suite/harness.ts";
+
+interface DialogModeAccess {
+	isInitialized: boolean;
+	editorContainer: Container;
+	createExtensionUIContext(): ExtensionUIContext;
+}
+
+type DialogKind = "select" | "input" | "editor" | "confirm";
+
+describe("InteractiveMode extension dialog program status", () => {
+	let harness: Harness;
+	let instance: InteractiveMode;
+	let mode: DialogModeAccess;
+	let ui: ExtensionUIContext;
+	let reports: ProgramStatus[];
+
+	beforeEach(async () => {
+		initTheme("dark");
+		harness = await createHarness();
+		vi.stubEnv("PI_CODING_AGENT_DIR", harness.tempDir);
+		const terminal: Terminal = new VirtualTerminal(100, 24);
+		reports = [];
+		vi.spyOn(terminal, "setProgramStatus").mockImplementation((status) => {
+			reports.push(status);
+		});
+		// Only the session and lifecycle registration callbacks are used by this constructor.
+		const runtime = {
+			session: harness.session,
+			setBeforeSessionInvalidate: vi.fn(),
+			setRebindSession: vi.fn(),
+		} as unknown as AgentSessionRuntime;
+		instance = new InteractiveMode(runtime, { terminal });
+		// Exercise the real dialog mounting and status reporter, not a replacement implementation.
+		mode = instance as unknown as DialogModeAccess;
+		mode.isInitialized = true;
+		ui = mode.createExtensionUIContext();
+	});
+
+	afterEach(() => {
+		instance?.stop();
+		harness?.cleanup();
+		vi.restoreAllMocks();
+		vi.unstubAllEnvs();
+	});
+
+	function open(kind: DialogKind, title: string): Promise<unknown> {
+		switch (kind) {
+			case "select":
+				return ui.select(title, ["Yes"]);
+			case "input":
+				return ui.input(title);
+			case "editor":
+				return ui.editor(title);
+			case "confirm":
+				return ui.confirm(title, "Allow this action?");
+		}
+	}
+
+	it.each([
+		["select", "input"],
+		["input", "editor"],
+		["editor", "select"],
+		["select", "select"],
+		["input", "confirm"],
+	] as const)("keeps %s → %s blocked until the replacement closes", async (previous, replacement) => {
+		const first = open(previous, "First dialog");
+		const oldSurface = mode.editorContainer.children[0]!;
+		const second = open(replacement, "Replacement dialog");
+		const currentSurface = mode.editorContainer.children[0]!;
+		const expected = {
+			state: "blocked",
+			kind: replacement === "confirm" ? "permission" : "question",
+			message: "Replacement dialog",
+		};
+		expect(reports.at(-1)).toMatchObject(expected);
+
+		// A displaced operation may finish later; it must not clear the live dialog's status.
+		oldSurface.handleInput!("\x1b");
+		await first;
+		expect(reports.at(-1)).toMatchObject(expected);
+		expect(mode.editorContainer.children).toEqual([currentSurface]);
+
+		currentSurface.handleInput!("\x1b");
+		await second;
+		expect(reports.at(-1)).toMatchObject({ state: "idle" });
+	});
+});
