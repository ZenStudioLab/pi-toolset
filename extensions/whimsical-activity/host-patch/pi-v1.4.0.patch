+	list.handleInput("\r");
+	return { selector, list };
+}
+function animation(list: ReturnType<SettingsSelectorComponent["getSettingsList"]>) {
+	list.handleInput("\x1b[B");
+	list.handleInput("\x1b[B");
+	list.handleInput("\r");
+}
