+	it("AM01/11: retry/countdown/summary/compaction retain native colors and real text without words", () => {
+		const statuses = [
+			new RetryStatusIndicator(ui, 1, 3, 5000),
+			new CompactionStatusIndicator(ui, "overflow"),
+			new BranchSummaryStatusIndicator(ui),
+		];
+		for (const status of statuses) {
