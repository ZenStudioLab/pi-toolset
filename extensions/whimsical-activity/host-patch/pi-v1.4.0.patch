+	focused = false;
+	inputs: string[] = [];
+	dispose = vi.fn();
+	handleInput(data: string): void {
+		this.inputs.push(data);
+	}
+	render(): string[] {
+		return ["CUSTOM"];
+	}
+	invalidate(): void {}
+}
