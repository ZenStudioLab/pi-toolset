@@ -0,0 +1,70 @@
+/** Native presentation settings; no activity or word-selection state is persisted. */
+export const ACTIVITY_PRESET_IDS = [
+	"asterisk",
+	"braille",
+	"dots",
+	"orbit",
+	"arc",
+	"diamond",
+	"pulse",
+	"blocks",
+	"classic",
+	"bounce",
+] as const;
+export type ActivityPresetId = (typeof ACTIVITY_PRESET_IDS)[number];
+
+export interface ActivityIndicatorPreferences {
+	enabled: boolean;
+	text: "whimsical" | "operational" | "both";
+	animation: ActivityPresetId | "random";
+	randomTiming: "once-per-run" | "periodically";
+	color: "theme" | "claude";
+	motion: "normal" | "reduced" | "plain";
+	ascii: boolean;
+	showElapsed: boolean;
+	showAction: boolean;
+	showOutputTokens: boolean;
+}
+
+/** Only explicit invocation controls belong here; absence inherits saved preferences. */
+export interface ActivityDecorationOverrides {
+	enabled?: false;
+	motion?: ActivityIndicatorPreferences["motion"];
+	ascii?: boolean;
+}
+
+export const DEFAULT_ACTIVITY_INDICATOR_PREFERENCES: Readonly<ActivityIndicatorPreferences> = Object.freeze({
+	enabled: true,
+	text: "whimsical",
+	animation: "asterisk",
+	randomTiming: "once-per-run",
+	color: "theme",
+	motion: "normal",
+	ascii: false,
+	showElapsed: true,
+	showAction: true,
+	showOutputTokens: true,
+});
+
+/** Validate each field independently without mutating or writing the input settings. */
+export function normalizeActivityIndicatorPreferences(value: unknown): ActivityIndicatorPreferences {
+	const fields =
+		typeof value === "object" && value !== null && !Array.isArray(value) ? (value as Record<string, unknown>) : {};
+	const defaults = DEFAULT_ACTIVITY_INDICATOR_PREFERENCES;
+	return {
+		enabled: typeof fields.enabled === "boolean" ? fields.enabled : defaults.enabled,
+		text: fields.text === "operational" || fields.text === "both" ? fields.text : defaults.text,
+		animation:
+			fields.animation === "random" || ACTIVITY_PRESET_IDS.some((id) => id === fields.animation)
+				? (fields.animation as ActivityIndicatorPreferences["animation"])
+				: defaults.animation,
+		randomTiming: fields.randomTiming === "periodically" ? fields.randomTiming : defaults.randomTiming,
+		color: fields.color === "claude" ? fields.color : defaults.color,
+		motion: fields.motion === "reduced" || fields.motion === "plain" ? fields.motion : defaults.motion,
+		ascii: typeof fields.ascii === "boolean" ? fields.ascii : defaults.ascii,
+		showElapsed: typeof fields.showElapsed === "boolean" ? fields.showElapsed : defaults.showElapsed,
+		showAction: typeof fields.showAction === "boolean" ? fields.showAction : defaults.showAction,
+		showOutputTokens:
+			typeof fields.showOutputTokens === "boolean" ? fields.showOutputTokens : defaults.showOutputTokens,
+	};
+}
