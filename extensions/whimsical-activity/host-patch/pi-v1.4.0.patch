+		expect(persisted).toEqual(["reduced", "plain", "normal"]);
+		console.log(JSON.stringify({ shadow: "CLI", saved: persisted, effective: f.state().preferences.motion }));
+		list.handleInput("\x1b");
+		list.handleInput("\x1b");
