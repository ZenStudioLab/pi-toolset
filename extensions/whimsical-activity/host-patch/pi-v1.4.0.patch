+			this.presetId = undefined;
+			this.presetDeadline = undefined;
+		}
+		if (this.lastPreferences?.randomTiming !== preferences.randomTiming) this.presetDeadline = undefined;
+		this.lastPreferences = preferences;
+		// A phase transfer revokes queued callbacks, but preserves an unsuppressed deadline.
+		this.cancelPresetTimer();
+		this.cancelElapsedTimer();
