+				for (let index = 0; index < row; index++) list.handleInput("\x1b[B");
+				const oldIndex = values.indexOf(settings.getActivityIndicatorPreferences()[key]);
+				list.handleInput("\r"); // Open explicit choices, then highlight the intended value.
+				for (let previous = 0; previous < oldIndex; previous++) list.handleInput("\x1b[A");
+				for (let next = 0; next < values.indexOf(value); next++) list.handleInput("\x1b[B");
+				list.handleInput("\r");
+				await settings.flush();
+				expect(settings.getActivityIndicatorPreferences()[key]).toBe(value);
+				list.handleInput("\x1b");
+				list.handleInput("\x1b");
+				await settings.reload();
+				expect(settings.getActivityIndicatorPreferences()[key]).toBe(value);
