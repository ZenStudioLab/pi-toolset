+		assert.strictEqual(schedule.mock.calls.length, 1);
+		t.mock.timers.tick(80);
+		assert.strictEqual(displayed(loader), "fresh:⠼ fresh:Retrying");
+		loader.stop();
+		advanceClock(1000);
+		loader.setMessage("Stopped");
+		loader.invalidate();
+		assert.strictEqual(displayed(loader), "fresh:⠼ fresh:Stopped");
+		assert.strictEqual(schedule.mock.calls.length, 1);
+	});
+});
