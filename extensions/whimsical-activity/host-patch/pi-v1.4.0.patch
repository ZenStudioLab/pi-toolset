+import { Container, Loader, type SettingItem, SettingsList, Text, type TUI } from "@earendil-works/pi-tui";
+import type {
+	ActivityDecorationOverrides,
+	ActivityIndicatorPreferences,
+} from "../../../core/activity-indicator-preferences.ts";
+import {
+	ACTIVITY_FRAME_INTERVAL_MS,
+	ACTIVITY_PRESETS,
+	activityPresetFrames,
+	colorActivity,
+	getActivityPreset,
+	RANDOM_ACTIVITY_WIDTH,
+} from "../activity-presets.ts";
+import { getSettingsListTheme, theme } from "../theme/theme.ts";
+import { SelectSubmenu } from "./settings-submenu.ts";
+
+export interface ActivityIndicatorSettingsPort {
+	ui: TUI;
+	getState(): {
+		available: boolean;
+		saved: Readonly<ActivityIndicatorPreferences>;
+		effective: Readonly<ActivityIndicatorPreferences>;
+		overrides: Readonly<ActivityDecorationOverrides>;
+	};
+	change<K extends keyof ActivityIndicatorPreferences>(key: K, value: ActivityIndicatorPreferences[K]): void;
+}
+
+class PresetPreview extends Loader {
+	private color: ActivityIndicatorPreferences["color"];
+	constructor(ui: TUI, color: ActivityIndicatorPreferences["color"]) {
+		super(
+			ui,
+			(text) => text,
+			(text) => theme.fg("muted", text),
+			"Preview",
+			{ frames: [] },
+		);
+		this.color = color;
+	}
+	protected override getRenderedIndicator(): string {
+		return colorActivity(super.getRenderedIndicator(), this.color ?? "theme");
+	}
+}
+
+/** Preview is independent of busy status, run random choices, and the extension's word bank. */
+class AnimationSubmenu extends Container {
+	private menu: SelectSubmenu;
+	private preview: PresetPreview;
+	private disposed = false;
+	constructor(port: ActivityIndicatorSettingsPort, onDone: (value?: string) => void) {
+		super();
+		const preferences = port.getState().effective;
+		this.preview = new PresetPreview(port.ui, preferences.color);
+		const highlight = (value: string) => {
+			if (this.disposed) return;
+			const preset = ACTIVITY_PRESETS.find((entry) => entry.id === value) ?? getActivityPreset("asterisk");
+			this.preview.setIndicator({
+				frames: activityPresetFrames(
+					preset,
+					value === "random" ? RANDOM_ACTIVITY_WIDTH : preset.width,
+					preferences.motion !== "normal",
+				),
+				intervalMs: ACTIVITY_FRAME_INTERVAL_MS,
+			});
+		};
+		const finish = (value?: string) => {
+			if (this.disposed) return;
+			this.dispose();
+			onDone(value);
+		};
+		this.menu = new SelectSubmenu(
+			"Animation",
+			"Preview only; Enter confirms. Random previews Asterisk without choosing a run preset.",
+			[
+				...ACTIVITY_PRESETS.map((preset) => ({ value: preset.id, label: preset.name })),
+				{ value: "random", label: "Random" },
+			],
+			preferences.animation,
+			finish,
+			() => finish(),
+			highlight,
+		);
+		this.addChild(this.menu);
+		this.addChild(this.preview);
+		highlight(preferences.animation);
+	}
+	handleInput(data: string): void {
+		if (!this.disposed) this.menu.handleInput(data);
+	}
+	dispose(): void {
+		if (this.disposed) return;
+		this.disposed = true;
+		this.preview.stop();
+	}
+}
+
+/** Owns nested preview cleanup because SettingsList does not dispose closed submenus. */
+export class ActivityIndicatorSettingsSubmenu extends Container {
+	private list: SettingsList;
+	private preview: AnimationSubmenu | undefined;
+	private disposed = false;
+	constructor(port: ActivityIndicatorSettingsPort, onDone: () => void) {
+		super();
+		this.addChild(new Text(theme.bold(theme.fg("accent", "Activity indicator")), 0, 0));
+		const state = port.getState();
+		this.addChild(
+			new Text(
+				state.available
+					? "Compatible decorator registered."
+					: "Unavailable: load a compatible activity decorator; saved settings are inert without it.",
+				0,
+				0,
+			),
+		);
+		this.addChild(
+			new Text(
+				"Confirmed choices save globally. Project settings and explicit invocation overrides take precedence.",
+				0,
+				0,
+			),
+		);
+		const overrides = Object.entries(state.overrides)
+			.map(([key, value]) => `${key}=${value}`)
+			.join(", ");
+		if (overrides) this.addChild(new Text(`Invocation overrides: ${overrides}`, 0, 0));
+		if (state.overrides.enabled === false)
+			this.addChild(new Text("Disabled for this invocation; saved choices cannot enable it.", 0, 0));
+		const prefs = state.effective;
+		const items: SettingItem[] = [
+			{ id: "enabled", label: "Enabled", currentValue: String(prefs.enabled), values: ["true", "false"] },
+			{ id: "text", label: "Activity text", currentValue: prefs.text, values: ["whimsical", "operational", "both"] },
+			{
+				id: "animation",
+				label: "Animation",
+				currentValue: prefs.animation,
+				submenu: (_value, done) => {
+					this.preview?.dispose();
+					this.preview = new AnimationSubmenu(port, (value) => {
+						this.preview = undefined;
+						done(value);
+					});
+					return this.preview;
+				},
+			},
+			{
+				id: "randomTiming",
+				label: "Random timing",
+				description:
+					"Only applies to Random: once per run, or every 8 visible-busy seconds. Reduced/Plain suppress switching.",
+				currentValue: prefs.randomTiming,
+				values: ["once-per-run", "periodically"],
+			},
+			{
+				id: "color",
+				label: "Color",
+				description:
+					"Theme accent, or Claude Code 2.1.287 terracotta (#D77757). Actual native status colors are unchanged.",
+				currentValue: prefs.color,
+				values: ["theme", "claude"],
+			},
+			{ id: "motion", label: "Motion", currentValue: prefs.motion, values: ["normal", "reduced", "plain"] },
+			{ id: "ascii", label: "ASCII punctuation", currentValue: String(prefs.ascii), values: ["false", "true"] },
+			{
+				id: "showElapsed",
+				label: "Elapsed time",
+				description: "Whole seconds since this run began, including retries and user waits. Absent in Plain.",
+				currentValue: String(prefs.showElapsed),
+				values: ["true", "false"],
+			},
+			{
+				id: "showAction",
+				label: "Current action",
+				description: "Active foreground tool names/counts or actual response reception; never inferred thinking.",
+				currentValue: String(prefs.showAction),
+				values: ["true", "false"],
+			},
+			{
+				id: "showOutputTokens",
+				label: "Output tokens",
+				description:
+					"Reported main-response run subtotal, not session totals. May arrive only at completion or stay incomplete while work continues.",
+				currentValue: String(prefs.showOutputTokens),
+				values: ["true", "false"],
+			},
+		];
+		// Effective values may stay overridden after a global save; explicit choices must remain reachable.
+		for (const item of items) {
+			const values = item.values;
+			if (!values) continue;
+			item.submenu = (value, done) =>
+				new SelectSubmenu(
+					item.label,
+					`${item.description ?? ""} Enter confirms a global choice. Project settings and invocation overrides still take precedence.`,
+					values.map((option) => ({ value: option, label: option })),
+					value,
+					done,
+					() => done(),
+				);
+		}
+		this.list = new SettingsList(
+			items,
+			7,
+			getSettingsListTheme(),
+			(id, value) => {
+				const key = id as keyof ActivityIndicatorPreferences;
+				port.change(
+					key,
+					key === "enabled" ||
+						key === "ascii" ||
+						key === "showElapsed" ||
+						key === "showAction" ||
+						key === "showOutputTokens"
+						? value === "true"
+						: (value as ActivityIndicatorPreferences[typeof key]),
+				);
+				const effective = port.getState().effective[key];
+				this.list.updateValue(id, String(effective));
+				port.ui.requestRender();
+			},
+			() => {
+				this.dispose();
+				onDone();
+			},
+		);
+		this.addChild(this.list);
+	}
+	handleInput(data: string): void {
+		if (!this.disposed) this.list.handleInput(data);
+	}
+	dispose(): void {
+		if (this.disposed) return;
+		this.disposed = true;
+		this.preview?.dispose();
+		this.preview = undefined;
+	}
+}
