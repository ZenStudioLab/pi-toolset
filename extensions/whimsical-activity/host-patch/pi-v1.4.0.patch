+			);
+			expect(stripAnsi(status.renderInBorder(120))).not.toContain("Noodling");
+			expect(stripAnsi(status.renderInBorder(120))).toContain("to cancel");
+		}
+		expect(statuses[0]!.renderInBorder(120)).toContain(theme.getFgAnsi("warning"));
+		vi.advanceTimersByTime(1000);
+		expect(stripAnsi(statuses[0]!.renderInBorder(120))).toContain("in 4s");
+		for (const status of statuses) status.dispose();
+	});
+	it.each([true, false])("AM11: Claude verified swatch uses trueColor=%s native conversion", (trueColor) => {
+		setCapabilityOverrides({ trueColor });
+		initTheme("dark", false);
+		const status = new WorkingStatusIndicator(ui, "Working", undefined, undefined, { generic: true });
+		status.setActivityDecoration(
+			{ label: "Noodling…", glyph: "static" },
+			{
+				preferences: normalizeActivityIndicatorPreferences({ color: "claude" }),
+				preset: getActivityPreset("asterisk"),
+				glyphWidth: 1,
+			},
+		);
+		const output = status.renderInBorder(80);
+		expect(output).toContain(foregroundAnsi(rgbColor(215, 119, 87), trueColor ? "truecolor" : "256color"));
+		if (trueColor) expect(output).toContain("\x1b[38;2;215;119;87m");
+		status.dispose();
+	});
+
+	it("AM11: Theme resolves every render; Claude uses native terminal color conversion", () => {
+		const status = new WorkingStatusIndicator(ui, "Working", undefined, undefined, { generic: true });
+		status.setActivityDecoration(
+			{ label: "Noodling…", glyph: "static" },
+			{
+				preferences: normalizeActivityIndicatorPreferences(undefined),
+				preset: getActivityPreset("asterisk"),
+				glyphWidth: 1,
+			},
+		);
+		const dark = status.renderInBorder(80);
+		initTheme("light", false);
+		const light = status.renderInBorder(80);
+		expect(light).not.toBe(dark);
+		expect(light).toContain(theme.fg("accent", "Noodling…"));
+		status.setActivityDecoration(
+			{ label: "Noodling…", glyph: "static" },
+			{
+				preferences: normalizeActivityIndicatorPreferences({ color: "claude" }),
+				preset: getActivityPreset("asterisk"),
+				glyphWidth: 1,
+			},
+		);
+		expect(status.renderInBorder(80)).toContain(colorActivity("Noodling…", "claude"));
+		expect(stripAnsi(status.renderInBorder(80))).toBe(stripAnsi(light));
+		status.dispose();
+	});
+	it.each([false, true])(
+		"AM01: invalid-bank native fallback uses typed provenance and %s ASCII punctuation without touching custom text",
+		(ascii) => {
+			const status = new WorkingStatusIndicator(ui, "Working", undefined, undefined, {
+				generic: true,
+				hint: "(Esc to cancel)",
+			});
+			const style = {
+				preferences: normalizeActivityIndicatorPreferences({ ascii }),
+				preset: getActivityPreset("asterisk"),
+				glyphWidth: 1,
+			};
+			status.setActivityDecoration({ nativeTextFallback: true, glyph: "static" }, style);
+			expect(stripAnsi(status.renderInBorder(80))).toBe(`✻ Working${ascii ? "..." : "…"} (Esc to cancel)`);
+			status.setActivityDecoration(
+				{ nativeTextFallback: true, glyph: "static" },
+				{ ...style, preferences: { ...style.preferences, text: "operational" } },
+			);
+			expect(stripAnsi(status.renderInBorder(80))).toBe("✻ Working (Esc to cancel)");
+			status.setWorkingMessage("Working", false, "(Esc to cancel)");
+			status.setActivityDecoration({ nativeTextFallback: true, glyph: "static" }, style);
+			expect(stripAnsi(status.renderInBorder(80))).toBe("✻ Working (Esc to cancel)");
+			status.dispose();
+		},
+	);
+
+	it("AM01/09: hidden/no-word/plain restore literal native text; custom ANSI indicator remains authoritative", () => {
+		const status = new WorkingStatusIndicator(ui, "Working", { frames: ["\x1b[31mX\x1b[0m"] }, undefined, {
+			generic: true,
+		});
+		const style = {
+			preferences: normalizeActivityIndicatorPreferences(undefined),
+			preset: getActivityPreset("bounce"),
+			glyphWidth: 5,
+		};
+		status.setActivityDecoration({ glyph: "static" }, style);
+		expect(stripAnsi(status.renderInBorder(80))).toBe("X Working");
+		expect(status.renderInBorder(80)).toContain("\x1b[31mX\x1b[0m");
+		status.setActivityDecoration(
+			{ label: "Noodling…", glyph: "animated" },
+			{ ...style, preferences: normalizeActivityIndicatorPreferences({ motion: "plain" }) },
+		);
+		expect(stripAnsi(status.renderInBorder(80))).toBe("Working");
+		expect(vi.getTimerCount()).toBe(0);
+		status.setActivityDecoration(undefined);
+		expect(stripAnsi(status.renderInBorder(80))).toBe("X Working");
+		status.dispose();
+	});
+});
