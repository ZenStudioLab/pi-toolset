+			this.owner?.setActivityDecoration(undefined);
+			this.owner?.setActivityMetadata(undefined);
+		}
+		try {
+			controller?.dispose();
+		} catch (error) {
+			this.report(`Activity decoration disposal failed: ${error instanceof Error ? error.message : String(error)}`);
+		}
+		if (controller) this.redraw();
+	}
+
+	getRunId(): symbol | undefined {
+		return this.runId;
+	}
+
