+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { AuthStorage } from "../src/core/auth-storage.ts";
+import { createEventBus } from "../src/core/event-bus.ts";
+import { createExtensionRuntime, loadExtensionFromFactory } from "../src/core/extensions/loader.ts";
+import { ExtensionRunner } from "../src/core/extensions/runner.ts";
+import type {
+	Extension,
+	ExtensionError,
+	ExtensionUIContext,
+	UIPromptStateSnapshot,
+} from "../src/core/extensions/types.ts";
+import type { ModelRegistry } from "../src/core/model-registry.ts";
+import { SessionManager } from "../src/core/session-manager.ts";
+import { createInMemoryModelRegistry } from "./model-runtime-test-utils.ts";
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	let reject!: (reason: unknown) => void;
+	const promise = new Promise<T>((resolvePromise, rejectPromise) => {
+		resolve = resolvePromise;
+		reject = rejectPromise;
+	});
+	return { promise, resolve, reject };
+}
+
+describe("ExtensionRunner synchronous UI prompt state", () => {
+	let modelRegistry: ModelRegistry;
+
+	beforeEach(async () => {
+		modelRegistry = await createInMemoryModelRegistry(AuthStorage.inMemory());
+	});
+
+	function createRunner(extensions: Extension[] = [], runtime = createExtensionRuntime()) {
+		return new ExtensionRunner(extensions, runtime, process.cwd(), SessionManager.inMemory(), modelRegistry);
+	}
+
+	it("delivers an immediate immutable content-free snapshot and an idempotent unsubscribe", async () => {
+		const runner = createRunner();
+		const snapshots: UIPromptStateSnapshot[] = [];
+		const unsubscribe = runner.onUIPromptStateChange((snapshot) => snapshots.push(snapshot));
+		expect(snapshots).toEqual([{ depth: 0, revision: 0 }]);
+		expect(Object.isFrozen(snapshots[0])).toBe(true);
+		expect(Reflect.set(snapshots[0], "depth", 10)).toBe(false);
+
+		const pending = deferred<boolean>();
+		runner.setUIContext({ ...runner.getUIContext(), confirm: () => pending.promise }, "tui");
+		const result = runner.getUIContext().confirm("private title", "private message");
+		expect(snapshots).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+		]);
+		const duringWait: UIPromptStateSnapshot[] = [];
+		const unsubscribeDuringWait = runner.onUIPromptStateChange((snapshot) => duringWait.push(snapshot));
+		expect(duringWait).toEqual([{ depth: 1, revision: 1 }]);
+		unsubscribe();
+		unsubscribe();
+		pending.resolve(true);
+		await expect(result).resolves.toBe(true);
+		expect(snapshots).toHaveLength(2);
+		expect(duringWait).toEqual([
+			{ depth: 1, revision: 1 },
+			{ depth: 0, revision: 2 },
+		]);
+		unsubscribeDuringWait();
+		expect(runner.getUIPromptState()).toEqual({ depth: 0, revision: 2 });
+	});
+
+	const promptCalls: [string, (ui: ExtensionUIContext) => Promise<unknown>][] = [
+		["select", (ui) => ui.select("title", ["choice"])],
+		["confirm", (ui) => ui.confirm("title", "message")],
+		["input", (ui) => ui.input("title", "placeholder")],
+		["editor", (ui) => ui.editor("title", "prefill")],
+		["custom", (ui) => ui.custom(async () => ({ render: () => [], invalidate: () => {} }))],
+		[
+			"hidden noncapturing custom overlay",
+			(ui) =>
+				ui.custom(async () => ({ render: () => [], invalidate: () => {} }), {
+					overlay: true,
+					overlayOptions: { nonCapturing: true, visible: () => false },
+				}),
+		],
+	];
+
+	it.each(promptCalls)("publishes before invoking %s and before its result settles", async (_kind, invoke) => {
+		const runner = createRunner();
+		const pending = deferred<void>();
+		const trace: string[] = [];
+		runner.onUIPromptStateChange(({ depth, revision }) => trace.push(`state:${depth}:${revision}`));
+		const operation = () => {
+			trace.push("open");
+			expect(runner.getUIPromptState()).toEqual({ depth: 1, revision: 1 });
+			return pending.promise;
+		};
+		runner.setUIContext(
+			{
+				...runner.getUIContext(),
+				select: async () => {
+					await operation();
+					return "choice";
+				},
+				confirm: async () => {
+					await operation();
+					return true;
+				},
+				input: async () => {
+					await operation();
+					return "input";
+				},
+				editor: async () => {
+					await operation();
+					return "edit";
+				},
+				custom: async <T>() => {
+					await operation();
+					return undefined as T;
+				},
+			},
+			"tui",
+		);
+		const result = invoke(runner.getUIContext()).then(() => trace.push("settled"));
+		expect(trace).toEqual(["state:0:0", "state:1:1", "open"]);
+		pending.resolve();
+		await result;
+		expect(trace).toEqual(["state:0:0", "state:1:1", "open", "state:0:2", "settled"]);
+	});
+
+	it.each(["resolve", "reject", "throw"] as const)("finishes exactly once on %s", async (outcome) => {
+		const runner = createRunner();
+		const failure = new Error("UI failure");
+		const snapshots: UIPromptStateSnapshot[] = [];
+		runner.onUIPromptStateChange((snapshot) => snapshots.push(snapshot));
+		runner.setUIContext(
+			{
+				...runner.getUIContext(),
+				confirm: () => {
+					if (outcome === "throw") throw failure;
+					return outcome === "reject" ? Promise.reject(failure) : Promise.resolve(false);
+				},
+			},
+			"tui",
+		);
+		if (outcome === "throw") {
+			expect(() => runner.getUIContext().confirm("title", "message")).toThrow(failure);
+		} else if (outcome === "reject") {
+			await expect(runner.getUIContext().confirm("title", "message")).rejects.toBe(failure);
+		} else {
+			await expect(runner.getUIContext().confirm("title", "message")).resolves.toBe(false);
+		}
+		expect(snapshots).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+			{ depth: 0, revision: 2 },
+		]);
+	});
+
+	it("publishes every nested and overlapping transition until the last wait finishes", async () => {
+		const runner = createRunner();
+		const outer = deferred<boolean>();
+		const inner = deferred<string | undefined>();
+		const overlap = deferred<string | undefined>();
+		const snapshots: UIPromptStateSnapshot[] = [];
+		runner.onUIPromptStateChange((snapshot) => snapshots.push(snapshot));
+		let innerResult: Promise<string | undefined> | undefined;
+		runner.setUIContext(
+			{
+				...runner.getUIContext(),
+				confirm: () => {
+					innerResult = runner.getUIContext().input("inner");
+					return outer.promise;
+				},
+				input: () => inner.promise,
+				editor: () => overlap.promise,
+			},
+			"tui",
+		);
+		const outerResult = runner.getUIContext().confirm("outer", "message");
+		const overlapResult = runner.getUIContext().editor("overlap");
+		inner.resolve("inner");
+		await innerResult;
+		outer.resolve(true);
+		await outerResult;
+		expect(runner.getUIPromptState()).toEqual({ depth: 1, revision: 5 });
+		overlap.resolve("overlap");
+		await overlapResult;
+		expect(snapshots).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+			{ depth: 2, revision: 2 },
+			{ depth: 3, revision: 3 },
+			{ depth: 2, revision: 4 },
+			{ depth: 1, revision: 5 },
+			{ depth: 0, revision: 6 },
+		]);
+	});
+
+	it("remains authoritative when legacy end is observed before legacy start", async () => {
+		const runtime = createExtensionRuntime();
+		const releaseStart = deferred<void>();
+		const observedStart = deferred<void>();
+		const observedEnd = deferred<void>();
+		const legacyOrder: string[] = [];
+		const extension = await loadExtensionFromFactory(
+			(pi) => {
+				pi.on("ui_prompt_start", async () => {
+					await releaseStart.promise;
+				});
+				pi.on("ui_prompt_start", () => {
+					legacyOrder.push("start");
+					observedStart.resolve();
+				});
+				pi.on("ui_prompt_end", () => {
+					legacyOrder.push("end");
+					observedEnd.resolve();
+				});
+			},
+			process.cwd(),
+			createEventBus(),
+			runtime,
+		);
+		const runner = createRunner([extension], runtime);
+		const snapshots: UIPromptStateSnapshot[] = [];
+		runner.onUIPromptStateChange((snapshot) => snapshots.push(snapshot));
+		runner.setUIContext({ ...runner.getUIContext(), confirm: async () => true }, "tui");
+		await runner.getUIContext().confirm("title", "message");
+		await observedEnd.promise;
+		expect(legacyOrder).toEqual(["end"]);
+		expect(runner.getUIPromptState()).toEqual({ depth: 0, revision: 2 });
+		releaseStart.resolve();
+		await observedStart.promise;
+		expect(legacyOrder).toEqual(["end", "start"]);
+		expect(snapshots).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+			{ depth: 0, revision: 2 },
+		]);
+	});
+
+	it("publishes current state before reentrant UI opens and preserves legacy prompt identity", async () => {
+		const runtime = createExtensionRuntime();
+		const ended: string[] = [];
+		const bothEnded = deferred<void>();
+		const extension = await loadExtensionFromFactory(
+			(pi) => {
+				pi.on("ui_prompt_end", (event) => {
+					ended.push(`${event.kind}:${event.title}`);
+					if (ended.length === 2) bothEnded.resolve();
+				});
+			},
+			process.cwd(),
+			createEventBus(),
+			runtime,
+		);
+		const runner = createRunner([extension], runtime);
+		const pending = deferred<string | undefined>();
+		const observed: { snapshot: UIPromptStateSnapshot; current: UIPromptStateSnapshot }[] = [];
+		const observedBeforeOpen: (UIPromptStateSnapshot | undefined)[] = [];
+		runner.setUIContext(
+			{
+				...runner.getUIContext(),
+				confirm: async () => true,
+				input: () => {
+					observedBeforeOpen.push(observed.at(-1)?.snapshot);
+					return pending.promise;
+				},
+			},
+			"tui",
+		);
+		let nextResult: Promise<string | undefined> | undefined;
+		runner.onUIPromptStateChange(({ revision }) => {
+			if (revision === 2) nextResult = runner.getUIContext().input("next");
+		});
+		runner.onUIPromptStateChange((snapshot) => observed.push({ snapshot, current: runner.getUIPromptState() }));
+		await runner.getUIContext().confirm("first", "message");
+		expect(runner.getUIPromptState()).toEqual({ depth: 1, revision: 3 });
+		pending.resolve("answer");
+		await nextResult;
+		await bothEnded.promise;
+		expect(ended).toEqual(["confirm:first", "input:next"]);
+		expect(observedBeforeOpen).toEqual([{ depth: 1, revision: 3 }]);
+		expect(observed.map(({ snapshot }) => snapshot)).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+			{ depth: 1, revision: 3 },
+			{ depth: 1, revision: 3 },
+			{ depth: 0, revision: 4 },
+		]);
+		expect(observed.map(({ snapshot }) => snapshot)).toEqual(observed.map(({ current }) => current));
+		expect(runner.getUIPromptState()).toEqual({ depth: 0, revision: 4 });
+	});
+
+	it("revokes listeners on invalidation while late overlapping finishes preserve legacy events", async () => {
+		const runtime = createExtensionRuntime();
+		const legacy: string[] = [];
+		const observedEnd = deferred<void>();
+		const extension = await loadExtensionFromFactory(
+			(pi) => {
+				pi.on("ui_prompt_start", (event) => {
+					legacy.push(`start:${event.kind}:${event.title}`);
+				});
+				pi.on("ui_prompt_end", (event) => {
+					legacy.push(`end:${event.kind}:${event.title}`);
+					observedEnd.resolve();
+				});
+			},
+			process.cwd(),
+			createEventBus(),
+			runtime,
+		);
+		const runner = createRunner([extension], runtime);
+		const first = deferred<boolean>();
+		const second = deferred<string | undefined>();
+		const confirm = vi.fn(() => first.promise);
+		runner.setUIContext({ ...runner.getUIContext(), confirm, input: () => second.promise }, "tui");
+		const capturedUI = runner.getUIContext();
+		const snapshots: UIPromptStateSnapshot[] = [];
+		const unsubscribe = runner.onUIPromptStateChange((snapshot) => snapshots.push(snapshot));
+		const firstResult = capturedUI.confirm("outer", "message");
+		const secondResult = capturedUI.input("inner");
+		runner.invalidate("replaced runner");
+		runner.invalidate("replaced again");
+		expect(() => runner.onUIPromptStateChange(() => {})).toThrow("replaced runner");
+		expect(() => capturedUI.confirm("late", "message")).toThrow("replaced runner");
+		expect(confirm).toHaveBeenCalledTimes(1);
+		const replacement = createRunner();
+		const replacementObserver = vi.fn();
+		replacement.onUIPromptStateChange(replacementObserver);
+		first.resolve(true);
+		await firstResult;
+		expect(runner.getUIPromptState()).toEqual({ depth: 1, revision: 3 });
+		const lateFailure = new Error("late UI failure");
+		second.reject(lateFailure);
+		await expect(secondResult).rejects.toBe(lateFailure);
+		await observedEnd.promise;
+		unsubscribe();
+		unsubscribe();
+		expect(snapshots).toEqual([
+			{ depth: 0, revision: 0 },
+			{ depth: 1, revision: 1 },
+			{ depth: 2, revision: 2 },
+		]);
+		expect(runner.getUIPromptState()).toEqual({ depth: 0, revision: 4 });
+		expect(replacementObserver.mock.calls).toEqual([[{ depth: 0, revision: 0 }]]);
+		expect(legacy).toEqual(["start:confirm:outer", "end:confirm:outer"]);
+	});
+
+	it("does not call an observer removed by an earlier observer in the same publication", async () => {
+		const runner = createRunner();
+		let unsubscribe = () => {};
+		runner.onUIPromptStateChange(({ depth }) => {
+			if (depth > 0) unsubscribe();
+		});
+		const observer = vi.fn();
+		unsubscribe = runner.onUIPromptStateChange(observer);
+		runner.setUIContext({ ...runner.getUIContext(), confirm: async () => true }, "tui");
+		await runner.getUIContext().confirm("title", "message");
+		expect(observer.mock.calls).toEqual([[{ depth: 0, revision: 0 }]]);
+	});
+
+	it.each([false, true])(
+		"isolates observer failures, including a throwing diagnostic sink: %s",
+		async (sinkThrows) => {
+			const runner = createRunner();
+			const errors: ExtensionError[] = [];
+			runner.onError((error) => {
+				errors.push(error);
+				if (sinkThrows) throw new Error("diagnostic failure");
+			});
+			const observerFailure = new Error("observer failure");
+			runner.onUIPromptStateChange(() => {
+				throw observerFailure;
+			});
+			const healthyObserver = vi.fn();
+			runner.onUIPromptStateChange(healthyObserver);
+			const confirm = vi.fn(async () => true);
+			runner.setUIContext({ ...runner.getUIContext(), confirm }, "tui");
+			await expect(runner.getUIContext().confirm("title", "message")).resolves.toBe(true);
+			expect(confirm).toHaveBeenCalledOnce();
+			expect(healthyObserver.mock.calls).toEqual([
+				[{ depth: 0, revision: 0 }],
+				[{ depth: 1, revision: 1 }],
+				[{ depth: 0, revision: 2 }],
+			]);
+			expect(errors).toEqual(
+				Array.from({ length: 3 }, () => ({
+					extensionPath: "<ui-prompt-state>",
+					event: "ui_prompt_state",
+					error: observerFailure.message,
+					stack: observerFailure.stack,
+				})),
+			);
+		},
+	);
+});
