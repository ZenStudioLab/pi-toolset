{
  "subagents": {
    "asyncByDefault": false,
    "defaultModel": "anthropic/claude-sonnet-5-5",
    "defaultThinking": "high",
    "agentOverrides": {
      "oracle": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high"
      },
      "scout": {
        "model": "anthropic/claude-haiku-4-5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "high"
      },
      "worker": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "high"
      },
      "delegate": {
        "model": "anthropic/claude-sonnet-5-5",
        "thinking": "high"
      }
    }
  }
}
