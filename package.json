{
  "name": "@zenstudiolab/pi-toolset",
  "version": "0.1.2",
  "description": "ZenStudioLab's Pi toolset. Whimsical Activity with stock Pi support and optional advanced patched-host integration.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenStudioLab/pi-toolset.git"
  },
  "homepage": "https://github.com/ZenStudioLab/pi-toolset#readme",
  "bugs": { "url": "https://github.com/ZenStudioLab/pi-toolset/issues" },
  "files": ["extensions/whimsical-activity/", "THIRD_PARTY_NOTICES.md"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "license": "MIT",
  "author": "ZenStudioLab",
  "keywords": ["pi-package", "pi", "extensions"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/whimsical-activity/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "pi": { "extensions": ["./extensions/whimsical-activity/index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  }
}
